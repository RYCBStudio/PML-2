<Project Sdk="Microsoft.NET.Sdk">

    <!--
      IconPacks Avalonia 12 兼容性探针（计划 P1.6 / P3 回归工具）。
      独立诊断工程，**不属于**主 sln，也不被任何项目引用；仅在需要时显式构建运行：
          dotnet run  （在 third_party/IconPacks.Avalonia/probe 目录下）

      存在的理由：NuGet 上的 IconPacks.Avalonia.* 2.0.0 在 Avalonia 12 下
      「还原通过 + 编译通过 + XAML 加载通过」，但真正套用 ControlTheme 时会抛
      MissingMethodException，图标静默渲染为空白。仅靠 restore/build 无法发现，
      必须实例化控件并强制套用模板。本探针即封装了这一验证。
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <NoWarn>CS8618;CS8603</NoWarn>

        <!-- 关键：本工程从属于仓库根 Directory.Packages.props 的 CPM 作用域，
             但需要独立钉住 Avalonia 12 版本，故自行关闭 CPM。 -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

        <!-- 避免继承 fork src/ 之外的任何给定配置 -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    </ItemGroup>

    <!-- 被测对象：仓库内已落地的 4 个图标包（而非 NuGet 二进制） -->
    <ItemGroup>
        <ProjectReference Include="..\src\IconPacks.Avalonia.Lucide\IconPacks.Avalonia.Lucide.csproj" />
        <ProjectReference Include="..\src\IconPacks.Avalonia.FileIcons\IconPacks.Avalonia.FileIcons.csproj" />
        <ProjectReference Include="..\src\IconPacks.Avalonia.Material\IconPacks.Avalonia.Material.csproj" />
        <ProjectReference Include="..\src\IconPacks.Avalonia.SimpleIcons\IconPacks.Avalonia.SimpleIcons.csproj" />
    </ItemGroup>

</Project>
