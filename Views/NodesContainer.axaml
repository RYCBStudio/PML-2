<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:MEFrpLauncherX.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:MEFrpLauncherX.ViewModels"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             x:Class="MEFrpLauncherX.Views.NodesContainer"
             x:DataType="viewModels:NodesContainerViewModel">
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Search and filter bar -->
        <Border Grid.Row="0"
                Margin="0,0,0,5"
                Padding="10">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBox Width="200" VerticalAlignment="Center"
                         Watermark="搜索节点..."
                         FontFamily="{StaticResource GlobalFontFamily}"
                         Text="{Binding SearchText}" />

                <CheckBox Margin="15,0,0,0"
                          Content="仅显示可建站节点" VerticalAlignment="Center"
                          FontFamily="{StaticResource GlobalFontFamily}"
                          IsChecked="{Binding FilterCanBuildSite}" />
                <CheckBox Margin="15,0,0,0"
                          Content="仅显示允许大流量节点" VerticalAlignment="Center"
                          FontFamily="{StaticResource GlobalFontFamily}"
                          IsChecked="{Binding FilterAllowHighTraffic}" />
                <CheckBox Margin="15,0,0,0"
                          Content="仅显示未过载节点" VerticalAlignment="Center"
                          FontFamily="{StaticResource GlobalFontFamily}"
                          IsChecked="{Binding FilterNotOverLoaded}" />
            </StackPanel>
        </Border>

        <!-- Region tabs -->
        <TabStrip Grid.Row="1"
                  Margin="0,0,0,10"
                  FontFamily="{StaticResource GlobalFontFamily}"
                  SelectedIndex="0"
                  SelectedItem="{Binding SelectedRegion, Mode=TwoWay}">
            <TabStripItem Content="全部" Tag="all" />
            <TabStripItem Content="中国大陆" Tag="cn" />
            <TabStripItem Content="港澳台" Tag="cnos" />
            <TabStripItem Content="海外" Tag="oversea" />
        </TabStrip>

        <!-- Node list -->
        <controls:ProgressRing Grid.Row="2"
                               IsIndeterminate="True"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoading}" />
        <ListBox Grid.Row="2"
                 x:Name="Nodes"
                 Background="Transparent"
                 ItemsSource="{Binding FilteredNodes}"
                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                 IsVisible="{Binding !IsLoading}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="5"  LineSpacing="5"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ctrls:TunnelNodeControl x:Name="tnc"
                                             VerticalAlignment="Center"
                                             Width="250"
                                             Height="240"
                                             DataContext="{Binding}"
                                             IsEnabled="{Binding IsNotOverloaded, DataType=ctrls:TunnelNodeViewModel}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <!-- 关键点：将样式绑定到当前项（TunnelNodeViewModel） -->
                    <Setter Property="IsEnabled" Value="{Binding IsNotOverloaded, DataType=ctrls:TunnelNodeViewModel}" />
                    <Setter Property="IsSelected"
                            Value="{Binding IsSelected, Mode=TwoWay, DataType=ctrls:TunnelNodeViewModel}" />
                </Style>
                
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>