<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants Condition="'$(Configuration)' != 'Debug'">$(DefineConstants);AOT</DefineConstants>
    </PropertyGroup>

    <!-- 26.4 阶段 B：允许证书助手自检项目访问 internal 的 lego 参数组装逻辑 -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>PML2CertCheck</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <!-- 版本统一由仓库根目录 Directory.Packages.props 中央管理 -->
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.AvaloniaEdit" />
        <PackageReference Include="Downloader"/>
        <PackageReference Include="FeatherQR.SkiaSharp" />
        <PackageReference Include="FluentAvaloniaUI"/>
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia"/>
        <PackageReference Include="Message.Avalonia" />
        <PackageReference Include="MessageBox.Avalonia"/>
        <PackageReference Include="Microsoft.International.Converters.PinYinConverter" />
        <PackageReference Include="Microsoft.Management.Infrastructure" />
        <PackageReference Include="NPinyin.Core"/>
        <PackageReference Include="ReactiveUI"/>
        <!-- ReactiveUI 25 不再传递引入 System.Reactive，但本仓库仍直接使用
             System.Reactive.Unit（如 ReactiveCommand<Unit, Unit>）与 System.Reactive 命名空间，故显式引用。 -->
        <PackageReference Include="System.Reactive"/>

        <PackageReference Include="RestSharp"/>
        <PackageReference Include="Sentry" />
        <PackageReference Include="SkiaSharp"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies"/>
        <PackageReference Include="SkiaSharp.QrCode" />
        <PackageReference Include="System.Runtime.Caching"/>
        <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator"/>
        <PackageReference Include="YamlDotNet"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 26.5.0：版本槽位解析器与启动器 PML2.Launcher 共享同一份源码，
             保证「启动器读到的版本」与「主程序看到的布局」永远一致。 -->
        <Compile Include="..\Shared\VersionResolver.cs" Link="Shared\VersionResolver.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Update="FontResources.axaml">
            <Generator>MSBuild:Compile</Generator>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="RYCB.PML2.MEFrpCaptchaLib">
            <HintPath>..\MEFrpLauncherX\RYCB.PML2.MEFrpCaptchaLib.dll</HintPath>
        </Reference>
        <Reference Include="SecretLib">
          <HintPath>..\MEFrpLauncherX\SecretLib.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Languages.resx 使用 PublicResXFileCodeGenerator：在 VS/Rider 中编辑保存 resx 时自动重新生成
         public 属性的 Designer.cs（XAML 的 {x:Static} 需要 public 成员）。 -->
    <ItemGroup>
        <Compile Update="Controls\LoadingTip.axaml.cs">
            <DependentUpon>LoadingTip.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Languages\Languages.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Languages.resx</DependentUpon>
        </Compile>
        <Compile Update="Languages\Languages.en-US.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Languages.en-US.resx</DependentUpon>
        </Compile>
        <Compile Update="Languages\Languages.zh-hant.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Languages.zh-hant.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FluentAvalonia.MarkdownRender\FluentAvalonia.MarkdownRender.csproj"/>
        <ProjectReference Include="..\FluentAvalonia.MarkdownRender\FluentAvalonia.MarkdownRender\FluentAvalonia.MarkdownRender.csproj" />
        <ProjectReference Include="..\Notify.NET\Notify.NET.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Languages\Languages.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Languages.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Languages\Languages.en-US.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Languages.en-US.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Languages\Languages.zh-hant.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Languages.zh-hant.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

</Project>
