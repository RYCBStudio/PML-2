<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Cross platform (windows/linux/macos) Pty library for communicating with console applications. Uses native shim for .NET 7+ compatibility (no DOTNET_EnableWriteXorExecute required).</Description>
    <RootNamespace>Porta.Pty</RootNamespace>
  </PropertyGroup>

  <!-- Native runtime libraries for each platform -->
  <!-- These are built from src/Porta.Pty.Native and placed in the runtimes folder -->
  <!-- Copied to the output runtimes/<rid>/native/ layout; a NativeLibrary resolver in -->
  <!-- PlatformServices.cs loads them, since DllImport alone does not probe runtimes/ -->
  <!-- When a RuntimeIdentifier is specified, only the matching platform is copied -->
  <ItemGroup>
    <None Include="Native/linux-x64/native/libporta_pty.so"
          Link="runtimes/linux-x64/native/libporta_pty.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('Native/linux-x64/native/libporta_pty.so') AND ('$(RuntimeIdentifier)' == '' OR '$(RuntimeIdentifier)' == 'linux-x64')" />
    <None Include="Native/linux-arm64/native/libporta_pty.so"
          Link="runtimes/linux-arm64/native/libporta_pty.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('Native/linux-arm64/native/libporta_pty.so') AND ('$(RuntimeIdentifier)' == '' OR '$(RuntimeIdentifier)' == 'linux-arm64')" />
    <None Include="Native/osx-x64/native/libporta_pty.dylib"
          Link="runtimes/osx-x64/native/libporta_pty.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('Native/osx-x64/native/libporta_pty.dylib') AND ('$(RuntimeIdentifier)' == '' OR '$(RuntimeIdentifier)' == 'osx-x64')" />
    <None Include="Native/osx-arm64/native/libporta_pty.dylib"
          Link="runtimes/osx-arm64/native/libporta_pty.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('Native/osx-arm64/native/libporta_pty.dylib') AND ('$(RuntimeIdentifier)' == '' OR '$(RuntimeIdentifier)' == 'osx-arm64')" />
  </ItemGroup>

  <ItemGroup>
    <!-- <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" /> -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NativeMethods.txt" />
  </ItemGroup>
</Project>
