<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MEFrpLauncherX.CrashDisplayer.ViewModels"
             x:Class="MEFrpLauncherX.CrashDisplayer.Views.MainView"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*,Auto">

        <!--  标题区域  -->
        <Border
            Grid.Row="0"
            Padding="16,14"
            Background="#C42B1C">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="30"
                    Text="⚠️" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding OopsCrashed}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#FADCD7"
                        Text="{Binding HeaderSubtitle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  内容区域  -->
        <Grid Grid.Row="1" ColumnDefinitions="290,*">

            <!--  左侧幽默提示（保留原有幽默风格，改为主题感知配色）  -->
            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="12">

                        <!--  笑话标题  -->
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="18" Text="🎭" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Text="{Binding ProgrammerHumor}" />
                        </StackPanel>

                        <!--  笑话内容卡片  -->
                        <Border
                            Padding="16"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="22"
                                    Text="💡" />
                                <TextBlock
                                    FontSize="13"
                                    FontStyle="Italic"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding JokeMessage}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  提示文本  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding HumorNote}"
                            TextWrapping="Wrap" />

                        <Viewbox
                            Width="56"
                            Height="56"
                            Margin="0,4"
                            HorizontalAlignment="Center">
                            <TextBlock FontSize="40" Text="😅" />
                        </Viewbox>

                        <!--  错误信息速览  -->
                        <Border
                            Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ErrorSummary}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  右侧诊断与解决方案  -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Margin="16" Spacing="12">

                    <!--  错误原因卡片  -->
                    <Border
                        Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="18" Text="🔍" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Text="{Binding DiagnosisTitle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="22" Text="{Binding Diagnosis.Icon}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding Diagnosis.Title}" />
                            </StackPanel>
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Diagnosis.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  解决方案卡片  -->
                    <Border
                        Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="18" Text="🛠️" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Text="{Binding SolutionsTitle}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Diagnosis.Solutions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SolutionItem">
                                        <Grid Margin="0,3" ColumnDefinitions="Auto,*,Auto">
                                            <Border
                                                Width="20"
                                                Height="20"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                CornerRadius="10">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="•" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                Padding="12,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SolutionActionCommand}"
                                                CommandParameter="{Binding Action}"
                                                Content="{Binding ActionLabel}"
                                                FontSize="12"
                                                IsVisible="{Binding HasAction}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  错误详情（默认折叠，保持界面清爽）  -->
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Header="{Binding ErrorDetailsLabel}"
                        IsExpanded="False">
                        <TextBox
                            MinHeight="220"
                            AcceptsReturn="True"
                            FontFamily="Consolas, Courier New, monospace"
                            FontSize="12"
                            IsReadOnly="True"
                            Text="{Binding ErrorDetails}"
                            TextWrapping="NoWrap" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  底部按钮  -->
        <Border
            Grid.Row="2"
            Padding="12,10"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Padding="14,6"
                    Command="{Binding ReportCommand}"
                    Content="{Binding ReportIssue}" />
                <Button
                    Padding="14,6"
                    Command="{Binding CopyCommand}"
                    Content="{Binding CopyErrorInfo}" />
                <Button
                    Padding="14,6"
                    Classes="accent"
                    Command="{Binding RestartCommand}"
                    Content="{Binding RestartApplication}"
                    IsVisible="{Binding CanRestart}" />
                <Button
                    Padding="14,6"
                    Command="{Binding CloseCommand}"
                    Content="{Binding Close}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
