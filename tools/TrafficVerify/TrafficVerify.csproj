<Project Sdk="Microsoft.NET.Sdk">

    <!--
      TrafficVerify：PML 2 流量统计链路自检（26.5.1 C3 回归）

      用法：
        dotnet run 工具目录 tools/TrafficVerify

      背景（C3）：
        GetTrafficStatusAsync 在响应体是 HTML（网关/代理/CDN 的错误页）时
        `return default`（即 null），而三个调用点都直接解引用返回值：
          - UserCenterPage.axaml.cs    trafficStatusData.data
          - TrafficStatusControl.axaml.cs  (await ...).data
          - TrafficStatusControl.axaml.cs  r.code
        一旦触发就抛 NullReferenceException。

      验证内容：
        1. 永不返回 null：HTML / 空体 / 非法 JSON / HTTP 失败 / 正常 JSON 全覆盖
        2. 永不抛异常：任何异常输入都降级为带错误码的实例
        3. HTML 错误页 → code 502 且带 OriginFallbackFailed 提示
        4. 正常 JSON 能正确反序列化（含 data 各字段）
        5. 源码级断言：GetTrafficStatusAsync 不再出现 `return default`

      退出码：
        全部通过 => 退出码 0；任一失败 => 退出码 1 并打印失败原因
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AssemblyName>TrafficVerify</AssemblyName>
        <RootNamespace>TrafficVerify</RootNamespace>
        <!-- 避免 dotnet run 提示找不到项目 -->
        <ExcludeFromSolution>true</ExcludeFromSolution>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\MEFrpLauncherX.Core\MEFrpLauncherX.Core.csproj" />
    </ItemGroup>

</Project>
