<Project Sdk="Microsoft.NET.Sdk">

    <!--
      CaptchaVerify：PML 2 登录人机验证链路自检（26.5.1 C2 回归）

      用法：
        dotnet run 工具目录 tools/CaptchaVerify

      验证内容：
        1. 超时生效：验证码请求必须有显式超时（断网时不能挂满 RestSharp 默认的 100 秒）
        2. 失败不抛异常：challenge 请求失败时返回 null，而不是抛 JsonException
        3. 空响应体不崩：响应体为空 / 非 JSON 时安全返回 null
        4. 判定逻辑正确：ri 为 null 必须判为失败（不能当成成功放行）
        5. 加载态必复位：验证码流程失败后 IsBusy / IsFakeProgress 必须回到 false

      退出码：
        全部通过 => 退出码 0；任一失败 => 退出码 1 并打印失败原因
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AssemblyName>CaptchaVerify</AssemblyName>
        <RootNamespace>CaptchaVerify</RootNamespace>
        <!-- 避免 dotnet run 提示找不到项目 -->
        <ExcludeFromSolution>true</ExcludeFromSolution>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\MEFrpLauncherX.Core\MEFrpLauncherX.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- 验证码库在 Core 里是「DLL 引用」而非 PackageReference，
             不会传递给下游项目，这里必须显式引用才能用 Constants 改写请求地址。 -->
        <Reference Include="RYCB.PML2.MEFrpCaptchaLib">
            <HintPath>..\..\MEFrpLauncherX\RYCB.PML2.MEFrpCaptchaLib.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
