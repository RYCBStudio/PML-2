<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;win-arm64;linux-arm64;osx-arm64</RuntimeIdentifiers>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\meflx.ico</ApplicationIcon>
        <AssemblyVersion>26.5.0</AssemblyVersion>
        <NeutralLanguage>zh-Hans</NeutralLanguage>
        <Version>26.5.0</Version>
        <ApplicationVersion>26.5.0</ApplicationVersion>
        <LangVersion>preview</LangVersion>
        <Optimize>true</Optimize>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <SuppressTrimWarnings>true</SuppressTrimWarnings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <NoWarn>1701;1702;IL2121;CS8902;CS8603;CS8604;CS0169;CS8618;CS8600;CS8604;CS8762</NoWarn>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' != 'Debug' ">
        <SelfContained>true</SelfContained>
        <PublishAot>true</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>

        <!-- 体积优化 -->
        <OptimizationPreference>Size</OptimizationPreference>
        <UseSizeOptimizedLinq>true</UseSizeOptimizedLinq>
        <IlcOptimizationPreference>Size</IlcOptimizationPreference>
        <IlcTrimMetadata>true</IlcTrimMetadata>
        <IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
        <IlcDisableReflection>true</IlcDisableReflection>

        <!-- 裁剪与调试符号 -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>

        <!-- 运行时与 GC 优化 -->
        <TieredCompilation>false</TieredCompilation>
        <TieredPGO>false</TieredPGO>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
        <MetricsSupport>false</MetricsSupport>
        <EventSourceSupport>false</EventSourceSupport>
        
        
        <DefineConstants>$(DefineConstants);AOT</DefineConstants>
    </PropertyGroup>
    <PropertyGroup>
        <AppId>tech.rycb.mefrplauncherx</AppId>
        <AppName>PML 2</AppName>
        <DebControlDescription>功能强大、跨平台的 ME Frp 图形化启动工具。</DebControlDescription>
        <DesktopComment>功能强大、跨平台的 ME Frp 图形化启动工具。</DesktopComment>
        <DebControlHomepage>https://www.rycb.tech</DebControlHomepage>
        <DebControlSection>utils</DebControlSection>
        <DebControlMaintainer>RYCB Studio</DebControlMaintainer>
        <Png32x32IconFile>Assets\meflx@32x.png</Png32x32IconFile>
        <SvgIconFile>Assets\meflx.svg</SvgIconFile>
        <DesktopCategories>Education;Network</DesktopCategories>
        <InfoPermissions>autostart;notification;trayicon;clipboard</InfoPermissions>
        <DesktopExec>/opt/pml-2/mefrplauncherx</DesktopExec>
        <DebControlDepends>libx11-6, libice6, libsm6, libfontconfig1, ca-certificates, tzdata, libc6, libgcc1 | libgcc-s1, libgssapi-krb5-2, libstdc++6, zlib1g, libssl1.0.0 | libssl1.0.2 | libssl1.1 | libssl3, libicu | libicu74 | libicu72 | libicu71 | libicu70 | libicu69 | libicu68 | libicu67 | libicu66 | libicu65 | libicu63 | libicu60 | libicu57 | libicu55 | libicu52</DebControlDepends>
    </PropertyGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <AvaloniaResource Remove="artifacts\**" />
        <None Include="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <AvaloniaResource Include="Assets\splash.png" />

        <TrimmerRootDescriptor Include="TrimmerRoots.xml" />

        <AvaloniaResource Include="Assets\splash.png">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AvaloniaResource>

        <AvaloniaResource Update="Assets\splash.png">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AvaloniaResource>
        <!-- 26.3.1 M2：内置 Splash 样式预设图 -->
        <None Update="Resources\splash-dark.png">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\splash-minimal.png">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Config\Plugins\tech.rycb.plugin.demo-functions.yaml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Config\Plugins\tech.rycb.plugin.proxy-guard.yaml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Config\Plugins\tech.rycb.plugin.proxy-notify.yaml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Config\Plugins\create-proxy-template.yaml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <TargetPath>Config\Plugins\create-proxy-template.yaml</TargetPath>
        </None>
        <None Remove="Assets\splash.png" />
        <AvaloniaResource Include="Assets\splash.png" />
    </ItemGroup>
    <ItemGroup>
        <!-- 版本统一由仓库根目录 Directory.Packages.props 中央管理 -->
        <PackageReference Include="AsyncImageLoader.Avalonia" />
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.AvaloniaEdit" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
        <PackageReference Include="AvaloniaEdit.TextMate" />
        <PackageReference Include="Downloader" />
        <PackageReference Include="FluentAvaloniaUI" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
        <PackageReference Include="MessageBox.Avalonia" />
        <PackageReference Include="Microsoft.Management.Infrastructure" />
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
        <PackageReference Include="System.Runtime.Caching" />
        <PackageReference Include="Xaml.Behaviors.Avalonia" />
        <PackageReference Include="Xaml.Behaviors.Interactivity" />
        <PackageReference Remove="Packaging.Targets" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Iciclecreek.Avalonia.TerminalWindow\Iciclecreek.Avalonia.Terminal.csproj" />
        <ProjectReference Include="..\MEFrpLauncherX.Core\MEFrpLauncherX.Core.csproj" />
        <ProjectReference Include="..\MEFrpLauncherX.Fonts\MEFrpLauncherX.Fonts.csproj" />
        <ProjectReference Include="..\MEFrpLauncherX.Plugin\MEFrpLauncherX.Plugin.csproj" />
        <ProjectReference Include="..\RYCB.PML2.Extensions.MinecraftExtension\RYCB.PML2.Extensions.MinecraftExtension.csproj" />
        <ProjectReference Include="..\RYCB.PML2.Mixin.TerminalHelper\RYCB.PML2.Mixin.TerminalHelper.csproj" />
        <ProjectReference Include="..\FluentAvalonia.MarkdownRender\FluentAvalonia.MarkdownRender.csproj" />
        <!-- P1.6：IconPacks 改用本地源码 fork（third_party/IconPacks.Avalonia）。
             NuGet 2.0.0 针对 Avalonia 11 编译，在 Avalonia 12 下套用 ControlTheme 会抛
             MissingMethodException 导致图标静默空白；详见 third_party/IconPacks.Avalonia/README.md。
             程序集名与 avares:// 资源路径保持不变，App.axaml 无需改动。 -->
        <ProjectReference Include="..\third_party\IconPacks.Avalonia\src\IconPacks.Avalonia.Lucide\IconPacks.Avalonia.Lucide.csproj" />
        <ProjectReference Include="..\third_party\IconPacks.Avalonia\src\IconPacks.Avalonia.FileIcons\IconPacks.Avalonia.FileIcons.csproj" />
        <ProjectReference Include="..\third_party\IconPacks.Avalonia\src\IconPacks.Avalonia.Material\IconPacks.Avalonia.Material.csproj" />
        <ProjectReference Include="..\third_party\IconPacks.Avalonia\src\IconPacks.Avalonia.SimpleIcons\IconPacks.Avalonia.SimpleIcons.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Views\ConfigEditor.axaml.cs">
            <DependentUpon>ConfigEditor.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ALPSettings.axaml.cs">
            <DependentUpon>ALPSettings.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ProxyMonitor\ProxyFloat.axaml.cs">
            <DependentUpon>ProxyFloat.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Remove="artifacts\**" />
        <Compile Update="Controls\CreateProxy.axaml.cs">
            <DependentUpon>CreateProxy.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Appearance\ProxyFloatSettings.axaml.cs">
            <DependentUpon>ProxyFloatSettings.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ALPConfigEditor.axaml.cs">
            <DependentUpon>ALPConfigEditor.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <None Update="Resources\ini.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Resources\json.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Resources\Terminal.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Resources\toml.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Resources\yml.xshd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Remove="artifacts\**" />
        <None Update="Plugins\*.yaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Config\Plugins\%(Filename)%(Extension)</TargetPath>
        </None>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="mscorlib" />
        <Reference Include="RYCB.PML2.MEFrpCaptchaLib">
          <HintPath>RYCB.PML2.MEFrpCaptchaLib.dll</HintPath>
        </Reference>
        <Reference Include="SecretLib">
          <HintPath>SecretLib.dll</HintPath>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <AvaloniaXaml Remove="artifacts\**" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Remove="artifacts\**" />
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Remove="artifacts\**" />
    </ItemGroup>
</Project>
