<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MEFrpLauncherX.Controls.ManageProxyHelp">
    <Grid RowDefinitions="Auto,*,Auto,*,Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch" RowSpacing="5">
        <TextBlock Text="{x:Static languages:Languages.Text_ManageProxyHelp_SearchCommands}" Theme="{StaticResource BodyStrongTextBlockStyle}" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Row="1">
            <controls:InfoBar IsOpen="True" Title="{x:Static languages:Languages.Caption_Hint}" Message="{x:Static languages:Languages.Text_ManageProxyHelp_SearchSyntaxNote}"
                              Severity="Informational" />
            <WrapPanel ItemSpacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="/pid:n" FontFamily="{StaticResource Jbm}"
                               Background="{DynamicResource SmokeFillColorDefaultBrush}"
                               Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Static languages:Languages.Text_ManageProxyHelp_PidDescription}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="/nid:n" FontFamily="{StaticResource Jbm}"
                               Background="{DynamicResource SmokeFillColorDefaultBrush}"
                               Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Static languages:Languages.Text_ManageProxyHelp_NidDescription}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="/n:x" FontFamily="{StaticResource Jbm}"
                               Background="{DynamicResource SmokeFillColorDefaultBrush}"
                               Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Static languages:Languages.Text_ManageProxyHelp_NDescription}" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" ItemSpacing="15" HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock Text="{x:Static languages:Languages.Text_ManageProxyHelp_Examples}" Theme="{StaticResource {StaticResource BodyStrongTextBlockStyle}}"
                           FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="/pid:1" FontFamily="{StaticResource Jbm}" />
                    <TextBlock Text="{x:Static languages:Languages.Text_ManageProxyHelp_PidExample}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="/nid:1" FontFamily="{StaticResource Jbm}" />
                    <TextBlock Text="{x:Static languages:Languages.Text_ManageProxyHelp_NidExample}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{x:Static languages:Languages.Text_ManageProxyHelp_NExampleValue}" FontFamily="{StaticResource Jbm}" />
                    <TextBlock Text="{x:Static languages:Languages.Text_ManageProxyHelp_NExample}" />
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{x:Static languages:Languages.Text_ManageProxyHelp_ColorMeaning}" Theme="{StaticResource {StaticResource BodyStrongTextBlockStyle}}"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <WrapPanel Grid.Row="3" ItemSpacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:InfoBadge
                Background="{DynamicResource SystemFillColorSuccessBrush}"
                BorderThickness="-1"
                Foreground="Azure">
                <controls:InfoBadge.IconSource>
                    <controls:FontIconSource FontFamily="{StaticResource GlobalFontFamily}"
                                             Glyph="{x:Static languages:Languages.Text_ManageProxyHelp_GreenOnline}" />
                </controls:InfoBadge.IconSource>
            </controls:InfoBadge>
            <controls:InfoBadge
                Background="{DynamicResource SystemFillColorCriticalBrush}"
                BorderThickness="-1"
                Foreground="Azure">
                <controls:InfoBadge.IconSource>
                    <controls:FontIconSource FontFamily="{StaticResource GlobalFontFamily}"
                                             Glyph="{x:Static languages:Languages.Text_ManageProxyHelp_RedOffline}" />
                </controls:InfoBadge.IconSource>
            </controls:InfoBadge>
            <controls:InfoBadge
                Background="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="-1"
                Foreground="Black">
                <controls:InfoBadge.IconSource>
                    <controls:FontIconSource FontFamily="{StaticResource GlobalFontFamily}"
                                             Glyph="{x:Static languages:Languages.Text_ManageProxyHelp_YellowDisabled}" />
                </controls:InfoBadge.IconSource>
            </controls:InfoBadge>
        </WrapPanel>
        <TextBlock Grid.Row="4" Text="{x:Static languages:Languages.Text_ManageProxyHelp_Examples}" Theme="{StaticResource {StaticResource BodyStrongTextBlockStyle}}"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <WrapPanel Grid.Row="5" ItemSpacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Image Width="200" Stretch="Uniform" Source="../Assets/psh_1.png" />
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{x:Static languages:Languages.Text_ManageProxyHelp_ExampleOnline}" />
            </StackPanel>
            <StackPanel>
                <Image Width="200" Stretch="Uniform" Source="../Assets/psh_2.png" />
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{x:Static languages:Languages.Text_ManageProxyHelp_ExampleOffline}" />
            </StackPanel>
            <StackPanel>
                <Image Width="200" Stretch="Uniform" Source="../Assets/psh_3.png" />
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{x:Static languages:Languages.Text_ManageProxyHelp_ExampleOfflineDisabled}" />
            </StackPanel>
        </WrapPanel>
    </Grid>
</UserControl>