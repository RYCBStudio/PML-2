<UserControl x:Class="MEFrpLauncherX.Controls.PublicViewItem" 
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MEFrpLauncherX.Controls"
             x:DataType="controls:PublicViewItem">
    <UserControl.Resources>
        <FontFamily x:Key="DsDigital">avares://MEFrpLauncherX.Fonts/Fonts/#DS-Digital</FontFamily>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto">
        <controls:RollingNumberTextBlock
            x:Name="Number"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource DsDigital}"
            FontSize="20"
            TargetNumber="{Binding TargetNumber}" />
        <TextBlock
            x:Name="Desc"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource GlobalFontFamily}"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="{Binding Description}" />
    </Grid>
</UserControl>
