<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MEFrpLauncherX.Controls.TrafficStatusControl">
    <Grid RowDefinitions="Auto, *">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="时间范围:" VerticalAlignment="Center"/>
            <ComboBox SelectionChanged="UpdateData" SelectedIndex="0">
                <ComboBoxItem Content="最近7天" Tag="7"/>
                <ComboBoxItem Content="最近15天" Tag="15"/>
                <ComboBoxItem Content="最近30天" Tag="30"/>
            </ComboBox>
        </StackPanel>
        <avalonia:AvaPlot Grid.Row="1" x:Name="avaPlot" PointerWheelChanged="OnPointerWheelChanged"/>
    </Grid>
</UserControl>
