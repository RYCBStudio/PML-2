<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pml2="clr-namespace:MEFrpLauncherX.Controls"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:controls="clr-namespace:MEFrpLauncherX.ViewModels.Controls"
             xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MEFrpLauncherX.Controls.CreateProxy"
             x:DataType="controls:TunnelNodeViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="4" Classes="animated">
        <Grid x:Name="CurrentProxyInfo" Grid.Row="0" RowDefinitions="Auto,Auto,Auto">

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource GlobalFontFamily}" FontSize="15">
                    <Run FontWeight="Bold" Text="#" />
                    <Run FontWeight="Bold" Text="{Binding NodeId}" />
                    <Run Text="{Binding Name}" />
                </TextBlock>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Margin="0,5,0,0"
                       MaxHeight="100"
                       FontFamily="{StaticResource GlobalFontFamily}"
                       Foreground="Gray"
                       Text="{Binding Description}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap">
                <ToolTip.Tip>
                    <Binding Path="Description" />
                </ToolTip.Tip>
            </TextBlock>

            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding AllowTypes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Label Margin="0,0,5,0"
                                   Classes="Green"
                                   Content="{Binding}"
                                   FontFamily="{StaticResource GlobalFontFamily}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Label Margin="0,0,5,0"
                       Classes="Indigo"
                       Content="{Binding Bandwidth}"
                       FontFamily="{StaticResource GlobalFontFamily}" />
                <Label Content="{Binding AllowPorts, StringFormat={x:Static languages:Languages.Text_CreateProxy_AllowedPortRange}}" />
            </WrapPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="MainContainer">
            <StackPanel x:Name="OperationPanel" x:DataType="pml2:CreateProxyViewModel">
                <fa:FASettingsExpander Header="{x:Static languages:Languages.Text_CreateProxy_BasicSettings}"
                                     IconSource="AllApps"
                                     Description="{x:Static languages:Languages.Text_CreateProxy_BasicSettingsDescription}">
                    <fa:FASettingsExpanderItem Description="{x:Static languages:Languages.Text_CreateProxy_ProxyNamePlaceholder}">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_ProxyName}" IsRequired="True" />
                        <fa:FASettingsExpanderItem.Footer>
                            <TextBox
                                x:Name="ProxyNameBox"
                                Margin="5"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_ProxyNamePlaceholder}"
                                Text="{Binding ProxyName}" />

                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Description="{x:Static languages:Languages.Text_CreateProxy_LocalAddressPlaceholder}">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_LocalAddress}" IsRequired="True" />
                        <fa:FASettingsExpanderItem.Footer>
                            <TextBox
                                x:Name="LocalAddressBox"
                                Margin="5"
                                PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_LocalAddressPlaceholder}"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                Text="{Binding LocalAddress}" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem>
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_LocalPort}" IsRequired="True" />
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <!-- <Button Content="想要MC开服? 点击此处查找端口 (BETA)" Click="CheckPort" /> -->
                                <fa:FANumberBox
                                    x:Name="LocalPortNudBox"
                                    Margin="5"
                                    SpinButtonPlacementMode="Inline"
                                    FontFamily="{StaticResource GlobalFontFamily}"
                                    Maximum="65535"
                                    Minimum="0"
                                    Value="{Binding LocalPort}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource GlobalFontFamily}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{x:Static languages:Languages.Text_CreateProxy_QuickPorts}" />
                                <Button Content="80" Tag="80" Click="QuickPort_Click" FontFamily="{StaticResource GlobalFontFamily}" />
                                <Button Content="443" Tag="443" Click="QuickPort_Click" FontFamily="{StaticResource GlobalFontFamily}" />
                                <Button Content="22" Tag="22" Click="QuickPort_Click" FontFamily="{StaticResource GlobalFontFamily}" />
                                <Button Content="25565" Tag="25565" Click="QuickPort_Click" FontFamily="{StaticResource GlobalFontFamily}" />
                                <!-- 更多常用端口：按用途分组的下拉菜单。仅收录合规的常规服务端口，
                                     不含 HTTP/Socks 代理、VPN、穿透工具等违反 ME Frp 内容策略的端口。 -->
                                <DropDownButton
                                    x:Name="MorePortsBtn"
                                    FontFamily="{StaticResource GlobalFontFamily}"
                                    Content="{x:Static languages:Languages.Text_CreateProxy_PortPicker}">
                                    <ToolTip.Tip>
                                        <TextBlock MaxWidth="320"
                                                   TextWrapping="Wrap"
                                                   Text="{x:Static languages:Languages.Text_CreateProxy_PortPolicy}" />
                                    </ToolTip.Tip>
                                    <DropDownButton.Flyout>
                                        <fa:FAMenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <fa:FAMenuFlyoutSubItem Text="{x:Static languages:Languages.Text_CreateProxy_PortCategory_Website}">
                                                <fa:FAMenuFlyoutItem Text="80 · HTTP" Tag="80" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="443 · HTTPS" Tag="443" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="5244 · AList (HTTP)" Tag="5244" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="5245 · AList (HTTPS)" Tag="5245" Click="QuickPort_Click" />
                                            </fa:FAMenuFlyoutSubItem>
                                            <fa:FAMenuFlyoutSubItem Text="{x:Static languages:Languages.Text_CreateProxy_PortCategory_Game}">
                                                <fa:FAMenuFlyoutItem Text="25565 · Minecraft Java" Tag="25565" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="19132 · Minecraft Bedrock" Tag="19132" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="27015 · CS2 / Source" Tag="27015" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="8211 · Palworld" Tag="8211" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="10999 · Don't Starve Together" Tag="10999" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="30120 · FiveM" Tag="30120" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="7777 · ARK / Terraria" Tag="7777" Click="QuickPort_Click" />
                                            </fa:FAMenuFlyoutSubItem>
                                            <fa:FAMenuFlyoutSubItem Text="{x:Static languages:Languages.Text_CreateProxy_PortCategory_Database}">
                                                <fa:FAMenuFlyoutItem Text="3306 · MySQL / MariaDB" Tag="3306" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="5432 · PostgreSQL" Tag="5432" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="1433 · SQL Server" Tag="1433" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="6379 · Redis" Tag="6379" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="27017 · MongoDB" Tag="27017" Click="QuickPort_Click" />
                                            </fa:FAMenuFlyoutSubItem>
                                            <fa:FAMenuFlyoutSubItem Text="{x:Static languages:Languages.Text_CreateProxy_PortCategory_Developer}">
                                                <fa:FAMenuFlyoutItem Text="22 · SSH / SFTP" Tag="22" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="3000 · Node.js / Dev Server" Tag="3000" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="5672 · RabbitMQ" Tag="5672" Click="QuickPort_Click" />
                                                <fa:FAMenuFlyoutItem Text="9200 · Elasticsearch" Tag="9200" Click="QuickPort_Click" />
                                            </fa:FAMenuFlyoutSubItem>
                                            <fa:FAMenuFlyoutSeparator />
                                            <fa:FAMenuFlyoutItem Text="{x:Static languages:Languages.Text_CreateProxy_ViewContentPolicy}"
                                                                 Click="ViewContentPolicy_Click" />
                                        </fa:FAMenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem>
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_ProtocolType}" IsRequired="True" />
                        <fa:FASettingsExpanderItem.Footer>
                            <ComboBox
                                x:Name="ProtocolCbBox"
                                Margin="5"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                SelectedIndex="0"
                                SelectionChanged="ProtocolCbBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="RemotePortGrid">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_RemotePort}" IsRequired="True" />
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <fa:FANumberBox
                                    x:Name="RemotePortNudBox"
                                    Margin="5"
                                    SpinButtonPlacementMode="Inline"
                                    FontFamily="{StaticResource GlobalFontFamily}"
                                    Maximum="65535"
                                    Minimum="0"
                                    Value="{Binding RemotePort}" />
                                <Panel VerticalAlignment="Center">
                                    <Button
                                        x:Name="GetRemotePort"
                                        Margin="5"
                                        Click="GetRemotePort_Click"
                                        Content="{x:Static languages:Languages.Text_CreateProxy_GetRemotePort}"
                                        FontFamily="{StaticResource GlobalFontFamily}" />
                                    <fa:FAProgressRing IsVisible="False" IsIndeterminate="True" x:Name="Loading" />
                                </Panel>
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="SourceProtocolFASettingsExpanderItemForHttp" IsVisible="False">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_SourceProtocol}" IsRequired="False" />
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <RadioButton GroupName="http" x:Name="SameAsHttp" IsChecked="True">
                                    <TextBlock VerticalAlignment="Bottom" Text="{x:Static languages:Languages.Text_CreateProxy_SameAsHttp}" />
                                </RadioButton>
                                <RadioButton GroupName="http" x:Name="Http2Https">
                                    <TextBlock VerticalAlignment="Bottom">HTTPS</TextBlock>
                                </RadioButton>
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="SourceProtocolFASettingsExpanderItemForHttps" IsVisible="False">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_SourceProtocol}" IsRequired="False" />
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <RadioButton GroupName="https" x:Name="SameAsHttps" IsChecked="True">
                                    <TextBlock VerticalAlignment="Bottom" Text="{x:Static languages:Languages.Text_CreateProxy_SameAsHttps}" />
                                </RadioButton>
                                <RadioButton GroupName="https" x:Name="Https2Http">
                                    <TextBlock VerticalAlignment="Bottom">HTTP</TextBlock>
                                </RadioButton>
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="CertificateSettingsForPath" IsVisible="False" Content="{x:Static languages:Languages.Text_CreateProxy_SslCertPath}"
                                             Description="{x:Static languages:Languages.Text_CreateProxy_SslPathDescription}">
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBox x:Name="SslPathBox" PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_SslCertPathPlaceholder}" />
                                <!-- 26.4：从证书助手已签发的证书一键回填证书/密钥双路径 -->
                                <Button x:Name="PickCertificateButton" Click="PickCertificateFromAssistant"
                                        Content="{x:Static languages:Languages.Text_Certificate_SelectForTunnel}" />
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="CertificateSettingsForPrivateKey" IsVisible="False"
                                             Content="{x:Static languages:Languages.Text_CreateProxy_SslKeyPath}" Description="{x:Static languages:Languages.Text_CreateProxy_SslPathDescription}">
                        <fa:FASettingsExpanderItem.Footer>
                            <TextBox x:Name="SslKeyBox" PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_SslKeyPathPlaceholder}" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem
                        x:Name="RemoteAddressStackPanel" Description="{x:Static languages:Languages.Text_CreateProxy_BindDomainsDescription}"
                        IsVisible="False">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_BindDomains}" IsRequired="False" />
                        <fa:FASettingsExpanderItem.Footer>
                            <Button Click="EditDomains">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <fa:FASymbolIcon Symbol="Edit" />
                                        <TextBlock Text="{x:Static languages:Languages.Text_Global_Edit}" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander Header="{x:Static languages:Languages.Text_CreateProxy_AdvancedSettings}"
                                     IconSource="Code"
                                     Description="{x:Static languages:Languages.Text_CreateProxy_AdvancedSettingsDescription}">
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_SecurityOptions}" x:Name="SecurityOptionsFASettingsExpander"
                                             IsVisible="False">
                        <fa:FASettingsExpanderItem.Footer>
                            <ComboBox x:Name="SecurityOptionsSelect" SelectedIndex="0">
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_CreateProxy_Disabled}" />
                                <ComboBoxItem>HTTP Basic Auth</ComboBoxItem>
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_CreateProxy_AccessKey}" />
                            </ComboBox>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_AccessKey}" Description="{x:Static languages:Languages.Text_CreateProxy_AccessKeyDescription}"
                                             IsVisible="{Binding #SecurityOptionsSelect.SelectedIndex, Converter={x:Static pml2:SelectIndexToVisibleConverterReverse.Instance}}">
                        <fa:FASettingsExpanderItem.Footer>
                            <TextBox
                                x:Name="AccessKeyBox"
                                Margin="5"
                                PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_AccessKeyDescription}"
                                FontFamily="{StaticResource GlobalFontFamily}" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="HTTP Basic Auth" Description="{x:Static languages:Languages.Text_CreateProxy_HttpBasicAuthDescription}"
                                             IsVisible="{Binding #SecurityOptionsSelect.SelectedIndex, Converter={x:Static pml2:SelectIndexToVisibleConverter.Instance}}">
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBox
                                    x:Name="HTTPBasicAuthNameBox"
                                    Margin="5"
                                    PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_UsernamePlaceholder}"
                                    FontFamily="{StaticResource GlobalFontFamily}" />
                                <TextBox
                                    x:Name="HTTPBasicAuthPwdBox"
                                    Margin="5"
                                    PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_PasswordPlaceholder}"
                                    RevealPassword="{Binding #RevealPwdToggleBtn.IsChecked}"
                                    PasswordChar="•"
                                    FontFamily="{StaticResource GlobalFontFamily}" />
                                <ToggleButton x:Name="RevealPwdToggleBtn" HorizontalAlignment="Right"
                                              Margin="0 00 12 0">
                                    <ToggleButton.Content>
                                        <fa:FAFontIcon Glyph="&#xF78D;"
                                                     FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </ToggleButton.Content>
                                </ToggleButton>
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_TransmissionProtocol}"
                                             Description="{x:Static languages:Languages.Text_CreateProxy_TransmissionProtocolDescription}">
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <RadioButton GroupName="TransmissionProtocol" Content="TCP" IsChecked="True"
                                             x:Name="TpTcpRb" />
                                <RadioButton GroupName="TransmissionProtocol" Content="QUIC" x:Name="TpQuicRb" />
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_CustomRequestHeaders}" IsVisible="False" x:Name="CustomRequestHeaderSettings">
                        <fa:FASettingsExpanderItem.Footer>
                            <Button Click="EditRequestHeaders">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <fa:FASymbolIcon Symbol="Edit" />
                                        <TextBlock Text="{x:Static languages:Languages.Text_Global_Edit}" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_CustomResponseHeaders}" IsVisible="False" x:Name="CustomResponseHeaderSettings">
                        <fa:FASettingsExpanderItem.Footer>
                            <Button Click="EditResponseHeaders">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <fa:FASymbolIcon Symbol="Edit" />
                                        <TextBlock Text="{x:Static languages:Languages.Text_Global_Edit}" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="Locations" Description="{x:Static languages:Languages.Text_CreateProxy_LocationsDescription}" IsVisible="False"
                                             x:Name="LocationSettings">
                        <fa:FASettingsExpanderItem.Footer>
                            <Button Click="EditLocations">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <fa:FASymbolIcon Symbol="Edit" />
                                        <TextBlock Text="{x:Static languages:Languages.Text_Global_Edit}" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>

                    <fa:FASettingsExpanderItem Content="Proxy Protocol">
                        <fa:FASettingsExpanderItem.Footer>
                            <ComboBox
                                x:Name="ProxyProtocolCbBox"
                                Margin="5"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                SelectedIndex="0">
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_CreateProxy_NotEnabled}" />
                                <ComboBoxItem Content="v1" />
                                <ComboBoxItem Content="v2" />
                            </ComboBox>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_EnableEncryption}">
                        <fa:FASettingsExpanderItem.Footer>
                            <ToggleSwitch
                                x:Name="EnableCryptoCBox"
                                Margin="5,0,5,0"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                OffContent="{x:Static languages:Languages.Text_Global_No}"
                                OnContent="{x:Static languages:Languages.Text_Global_Yes}"
                                IsChecked="False" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_EnableCompression}">
                        <fa:FASettingsExpanderItem.Footer>
                            <ToggleSwitch
                                x:Name="EnableCompressCBox"
                                Margin="5,0,5,0"
                                OffContent="{x:Static languages:Languages.Text_Global_No}"
                                OnContent="{x:Static languages:Languages.Text_Global_Yes}"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                IsChecked="False" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander Header="{x:Static languages:Languages.Text_CreateProxy_Templates}"
                                     IconSource="SaveLocal"
                                     Description="{x:Static languages:Languages.Text_CreateProxy_TemplatesDescription}">
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_ApplyTemplate}">
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ComboBox
                                    x:Name="TemplateComboBox"
                                    Margin="5"
                                    Width="180"
                                    ItemsSource="{Binding Templates}"
                                    DisplayMemberBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedTemplate}"
                                    FontFamily="{StaticResource GlobalFontFamily}" />
                                <Button Click="ApplyTemplate_Click"
                                        Content="{x:Static languages:Languages.Text_CreateProxy_ApplyTemplate}"
                                        FontFamily="{StaticResource GlobalFontFamily}" />
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_SaveTemplate}">
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBox
                                    x:Name="TemplateNameBox"
                                    Margin="5"
                                    Width="180"
                                    Text="{Binding TemplateName}"
                                    PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_TemplateNameWatermark}"
                                    FontFamily="{StaticResource GlobalFontFamily}" />
                                <Button Click="SaveTemplate_Click"
                                        Content="{x:Static languages:Languages.Text_CreateProxy_SaveTemplate}"
                                        FontFamily="{StaticResource GlobalFontFamily}"
                                        Classes="Success" />
                                <Button Click="DeleteTemplate_Click"
                                        Content="{x:Static languages:Languages.Text_CreateProxy_DeleteTemplate}"
                                        FontFamily="{StaticResource GlobalFontFamily}"
                                        Classes="Danger" />
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                </fa:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>