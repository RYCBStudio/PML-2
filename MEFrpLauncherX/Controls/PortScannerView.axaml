<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:MEFrpLauncherX.ViewModels"
             xmlns:core="clr-namespace:MEFrpLauncherX.Core;assembly=MEFrpLauncherX.Core"
             xmlns:controls="clr-namespace:MEFrpLauncherX.Controls"
             xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
             x:Class="MEFrpLauncherX.Controls.PortScannerView"
             x:DataType="viewModels:PortScannerViewModel">

    <Design.DataContext>
        <viewModels:PortScannerViewModel />
    </Design.DataContext>
    <UserControl.Resources>

        <core:BoolToColorConverter x:Key="BoolToColorConverter" />
        <core:BoolToStatusConverter x:Key="BoolToStatusConverter" />
    </UserControl.Resources>

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="{x:Static languages:Languages.Text_PortScanner_Title}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10" />

        <!-- 扫描设置 -->
        <Border Padding="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static languages:Languages.Text_PortScanner_ScanSettings}" FontWeight="Bold" />

                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <TextBlock Text="{x:Static languages:Languages.Text_PortScanner_TargetIp}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding TargetIp}"
                             Grid.Column="1"
                             Watermark="{x:Static languages:Languages.Text_PortScanner_TargetIpPlaceholder}" />
                    <Button Content="{x:Static languages:Languages.Text_PortScanner_Localhost}"
                            Grid.Column="2"
                            Command="{Binding UseLocalhostCommand}"
                            Padding="10,2" />

                    <TextBlock Text="{x:Static languages:Languages.Text_PortScanner_PortRange}"
                               Grid.Row="1"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="5">
                        <TextBox Text="{Binding StartPort}"
                                 Width="80"
                                 Watermark="{x:Static languages:Languages.Text_PortScanner_StartPort}" />
                        <TextBlock Text="-" VerticalAlignment="Center" />
                        <TextBox Text="{Binding EndPort}"
                                 Width="80"
                                 Watermark="{x:Static languages:Languages.Text_PortScanner_EndPort}" />
                    </StackPanel>
                    <Button Content="{x:Static languages:Languages.Text_PortScanner_CommonPorts}"
                            Grid.Column="2"
                            Grid.Row="1"
                            Command="{Binding UseCommonPortsCommand}"
                            Padding="10,2" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 控制按钮 -->
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="{x:Static languages:Languages.Text_PortScanner_StartScan}"
                    Classes="accent"
                    Command="{Binding StartScanCommand}"
                    IsEnabled="{Binding IsNotScanning}"
                    Width="120"
                    Height="35" />

            <Button Content="{x:Static languages:Languages.Text_PortScanner_StopScan}"
                    Command="{Binding StopScanCommand}"
                    IsEnabled="{Binding IsScanning}"
                    Width="120"
                    Height="35" />

            <Button Content="{x:Static languages:Languages.Text_PortScanner_QuickScan}"
                    Command="{Binding QuickScanCommand}"
                    IsEnabled="{Binding IsNotScanning}"
                    Width="150"
                    Height="35" />
        </StackPanel>

        <!-- 进度显示 -->
        <Border IsVisible="{Binding IsScanning}"
                Padding="10"
                Background="{DynamicResource ControlFillColorTertiaryBrush}"
                CornerRadius="8">
            <StackPanel Spacing="5">
                <ProgressBar Value="{Binding ScanProgress}"
                             Maximum="100" />
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 扫描结果 -->
        <Border Padding="10" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8"
                BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Static languages:Languages.Text_PortScanner_ScanResults}" FontWeight="Bold" />
                    <TextBlock Text="{Binding ResultCount, StringFormat={x:Static languages:Languages.Text_PortScanner_ResultCountFormat}}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding ScanResults}"
                         SelectedItem="{Binding SelectedResult}"
                         Height="300"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    Margin="0,2" CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid ColumnDefinitions="60,80,*,100">
                                    <TextBlock Text="{Binding Port, StringFormat={x:Static languages:Languages.Text_PortScanner_PortFormat}}"
                                               FontWeight="Bold" />

                                    <Border Grid.Column="1"
                                            Background="{Binding IsOpen, Converter={StaticResource BoolToColorConverter}}"
                                            CornerRadius="8"
                                            HorizontalAlignment="Left"
                                            Padding="5,2"
                                            Width="60">
                                        <TextBlock
                                            Text="{Binding IsOpen, Converter={StaticResource BoolToStatusConverter}}"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            HorizontalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ServiceName}"
                                               VerticalAlignment="Center"
                                               Margin="10,0" />

                                    <Button Grid.Column="3"
                                            Content="{x:Static languages:Languages.Text_PortScanner_UseThisPort}"
                                            Command="{Binding $parent[controls:PortScannerView].DataContext.UsePortCommand}"
                                            CommandParameter="{Binding Port}"
                                            Padding="10,2" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="{x:Static languages:Languages.Text_PortScanner_CopySelectedPort}"
                            Command="{Binding CopySelectedPortCommand}"
                            IsEnabled="{Binding HasSelection}"
                            Padding="10,5" />

                    <Button Content="{x:Static languages:Languages.Text_PortScanner_ClearResults}"
                            Command="{Binding ClearResultsCommand}"
                            IsEnabled="{Binding HasResults}"
                            Padding="10,5" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>