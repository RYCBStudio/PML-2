<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:markdownAiRender="https://github.com/AIDotNet/Markdown.AIRender"
             xmlns:viewModels="clr-namespace:MEFrpLauncherX.ViewModels"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:core="clr-namespace:MEFrpLauncherX.Core;assembly=MEFrpLauncherX.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MEFrpLauncherX.Views.HomePage"
             x:DataType="viewModels:HomePageViewModel">
    <Design.DataContext>
        <viewModels:HomePageViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto, *" RowSpacing="10">

        <Border
            IsVisible="{Binding SystemStatus, Converter={x:Static core:StatusNumToVisibilityConverter.Instance}}"
            CornerRadius="10"
            Classes.Success="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToSuccessBackgroundConverter.Instance}}"
            Classes.Warning="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToWarningBackgroundConverter.Instance}}"
            Classes.Error="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToErrorBackgroundConverter.Instance}}"
            Classes.Fatal="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToFatalBackgroundConverter.Instance}}">

            <Grid Margin="5" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                  RowSpacing="5">
                <Ellipse Grid.RowSpan="2"
                         Classes.Success="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToSuccessBackgroundConverter.Instance}}"
                         Classes.Warning="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToWarningBackgroundConverter.Instance}}"
                         Classes.Error="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToErrorBackgroundConverter.Instance}}"
                         Classes.Fatal="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToFatalBackgroundConverter.Instance}}"
                         Height="10" Width="10">
                </Ellipse>
                <TextBlock Grid.Column="1"
                           FontWeight="Bold"
                           Text="{Binding SystemStatus,
                                   Converter={x:Static core:StatusNumToTextConverter.Instance}}"
                           Classes.Success="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToSuccessBackgroundConverter.Instance}}"
                           Classes.Warning="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToWarningBackgroundConverter.Instance}}"
                           Classes.Error="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToErrorBackgroundConverter.Instance}}"
                           Classes.Fatal="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToFatalBackgroundConverter.Instance}}">
                </TextBlock>
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding SystemStatusRemark}"

                           Classes.Success="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToSuccessBackgroundConverter.Instance}}"
                           Classes.Warning="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToWarningBackgroundConverter.Instance}}"
                           Classes.Error="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToErrorBackgroundConverter.Instance}}"
                           Classes.Fatal="{Binding SystemStatus, 
                    Converter={x:Static core:StatusNumToFatalBackgroundConverter.Instance}}">
                </TextBlock>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,1,*" ColumnSpacing="5">
            <Border Grid.ColumnSpan="3" Background="#2f000000">
                <controls:ProgressRing Height="40" IsVisible="{Binding IsLoading}">
                </controls:ProgressRing>
            </Border>
            <Border
                MaxHeight="650"
                Margin="10">
                <HeaderedContentControl Background="Transparent" Header="用户信息"
                                        FontFamily="{StaticResource GlobalFontFamily}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*,*,*">
                        <!-- 用户名 -->
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="用户名" FontFamily="{StaticResource GlobalFontFamily}" />
                            <SelectableTextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                                 Text="{Binding UserName}" />
                        </StackPanel>

                        <!-- 用户ID -->
                        <StackPanel Grid.Column="1">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="用户ID" FontFamily="{StaticResource GlobalFontFamily}" />
                            <SelectableTextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                                 Text="{Binding UserId}" />
                        </StackPanel>

                        <!-- 注册邮箱 -->
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="注册邮箱" FontFamily="{StaticResource GlobalFontFamily}" />
                            <SelectableTextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                                 Text="{Binding Email}" />
                        </StackPanel>


                        <!-- 用户组 -->
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="用户组" FontFamily="{StaticResource GlobalFontFamily}" />
                            <SelectableTextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                                 Text="{Binding Group}"
                                                 Classes.Danger="{Binding IsAdmin}" />
                        </StackPanel>

                        <!-- 入站带宽 -->
                        <StackPanel Grid.Row="5">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="入站带宽" FontFamily="{StaticResource GlobalFontFamily}" />
                            <SelectableTextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                                 Text="{Binding InBound}" />
                        </StackPanel>

                        <!-- 出站带宽 -->
                        <StackPanel Grid.Row="5" Grid.Column="1">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="出站带宽" FontFamily="{StaticResource GlobalFontFamily}" />
                            <SelectableTextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                                 Text="{Binding OutBound}" />
                        </StackPanel>

                        <!-- 隧道数量 -->
                        <StackPanel Grid.Row="4">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="隧道数量" FontFamily="{StaticResource GlobalFontFamily}" />
                            <SelectableTextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                                 Text="{Binding ProxiesCount}" />
                        </StackPanel>

                        <!-- 剩余流量 -->
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="剩余流量" FontFamily="{StaticResource GlobalFontFamily}" />
                            <SelectableTextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                                 Text="{Binding Traffic}" />
                        </StackPanel>

                        <!-- 注册时间 -->
                        <StackPanel Grid.Row="3">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="注册时间" FontFamily="{StaticResource GlobalFontFamily}" />
                            <SelectableTextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                                 Text="{Binding RegisterTime}" />
                        </StackPanel>

                        <!-- 实名状态 -->
                        <StackPanel Grid.Row="2">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="实名状态" FontFamily="{StaticResource GlobalFontFamily}" />
                            <TextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                       Text="{Binding RealNameStatus}"
                                       Classes.Success="{Binding IsRealNamed}"
                                       Classes.Danger="{Binding !IsRealNamed}" />
                        </StackPanel>

                        <!-- 今日签到 -->
                        <StackPanel Grid.Row="1">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="今日签到" FontFamily="{StaticResource GlobalFontFamily}" />
                            <Button
                                HorizontalAlignment="Left"
                                Command="{Binding SignCommand}"
                                Content="{Binding SignButtonText}"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                Classes="Success"
                                IsEnabled="{Binding CanSign}" />
                        </StackPanel>

                        <!-- 账户状态 -->
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="账户状态" FontFamily="{StaticResource GlobalFontFamily}" />
                            <TextBlock FontFamily="{StaticResource GlobalFontFamily}"
                                       Text="{Binding AccountStatus}"
                                       Classes.Danger="{Binding IsBanned}"
                                       Classes.Success="{Binding !IsBanned}" />
                        </StackPanel>
                    </Grid>
                </HeaderedContentControl>
            </Border>
            <GridSplitter Grid.Column="1"></GridSplitter>
            <!-- 公告 -->
            <Border
                Grid.Column="2"
                Margin="10">
                <Grid RowDefinitions="Auto,*">
                    <HeaderedContentControl Grid.Row="1" Header="系统公告" FontFamily="{StaticResource GlobalFontFamily}">
                        <ScrollViewer AllowAutoHide="True" HorizontalScrollBarVisibility="Disabled">
                            <markdownAiRender:MarkdownRender TextWrapping="Wrap"
                                                             FontFamily="{StaticResource GlobalFontFamily}"
                                                             x:Name="NoticeBoard" Value="{Binding NoticeContent}" />
                            <!-- <mdxaml:MarkdownScrollViewer Markdown="{Binding NoticeContent}"> -->
                            <!--     <mdxaml:MarkdownScrollViewer.Styles> -->
                            <!--         <StyleInclude Source="avares://MEFrpLauncherX/Styles/RichTextStyles.axaml"/> -->
                            <!--     </mdxaml:MarkdownScrollViewer.Styles> -->
                            <!-- </mdxaml:MarkdownScrollViewer> -->
                        </ScrollViewer>
                    </HeaderedContentControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>