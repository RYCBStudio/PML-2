<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:core="clr-namespace:MEFrpLauncherX.Core;assembly=MEFrpLauncherX.Core"
        xmlns:proxyMonitor="clr-namespace:MEFrpLauncherX.Views.ProxyMonitor"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
        MinWidth="300"
        Background="Transparent"
        ShowInTaskbar="False"
        x:Class="MEFrpLauncherX.Views.ProxyMonitor.ProxyFloat"
        x:DataType="proxyMonitor:ProxyFloatViewModel"
        Loaded="Setup"
        Opacity="{Binding Opacity}"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight">
    <Border CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BoxShadow="0 8 24 2 #33000000"
            Margin="6">
        <DockPanel Margin="12,8,10,10" HorizontalSpacing="8">
            <!-- 标题行 -->
            <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Top">
                <Image Source="/Assets/meflx.png" Stretch="Uniform" Height="18" VerticalAlignment="Center" />
                <TextBlock FontFamily="{StaticResource GlobalFontFamily}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}"
                           Text="{Binding WindowTitle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 菜单按钮 -->
            <Button x:Name="MenuButton"
                    DockPanel.Dock="Top"
                    HorizontalAlignment="Right"
                    Width="22"
                    Height="22"
                    Margin="0,-24,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    FontSize="14"
                    Content="⋯"
                    VerticalAlignment="Center">
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout Placement="Top">
                        <controls:MenuFlyoutItem Text="{x:Static languages:Languages.Text_ProxyFloat_RefreshTraffic}"
                                                 Command="{Binding RefreshTrafficCommand}" />
                        <controls:MenuFlyoutItem Text="{x:Static languages:Languages.Text_Global_Settings}"
                                                 Command="{Binding OpenSettingsCommand}" />
                        <controls:MenuFlyoutItem Text="{x:Static languages:Languages.Text_ProxyFloat_CloseFloat}"
                                                 Command="{Binding CloseFloatCommand}" />
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
            </Button>

            <!-- 隧道状态列表（与终端页启停真实同步） -->
            <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0" Spacing="4">
                <ItemsControl ItemsSource="{Binding TunnelItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="proxyMonitor:FloatTunnelItem">
                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,12,2">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           FontFamily="{StaticResource GlobalFontFamily}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center">
                                    <ToolTip.Tip>
                                        <TextBlock Text="{Binding StatusToolTip}" />
                                    </ToolTip.Tip>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Static languages:Languages.Text_ProxyFloat_NoRunningTunnels}"
                           IsVisible="{Binding HasNoTunnels}"
                           FontSize="12"
                           Opacity="0.6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 流量行 -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, *" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="#FF00B894" Text="&#xe673;" VerticalAlignment="Center" />
                    <TextBlock FontFamily="{StaticResource GlobalFontFamily}" FontSize="13"
                               Text="{Binding TrafficIn, Converter={x:Static core:BytesToReadableConverterEx.Instance}}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="14,0,0,0">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="#FF0984E3" Text="&#xe672;" VerticalAlignment="Center" />
                    <TextBlock FontFamily="{StaticResource GlobalFontFamily}" FontSize="13"
                               Text="{Binding TrafficOut, Converter={x:Static core:BytesToReadableConverterEx.Instance}}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 实时流量折线图（可在设置中关闭） -->
            <lvc:CartesianChart DockPanel.Dock="Top"
                                Height="56"
                                Margin="0,6,0,0"
                                IsVisible="{Binding ShowChart}"
                                Series="{Binding ChartSeries}"
                                XAxes="{Binding ChartXAxes}"
                                YAxes="{Binding ChartYAxes}" />
        </DockPanel>
    </Border>
</Window>
