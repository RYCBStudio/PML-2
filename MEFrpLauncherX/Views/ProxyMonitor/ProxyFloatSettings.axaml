<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        Width="600" Height="360"
        x:Class="MEFrpLauncherX.Views.ProxyMonitor.ProxyFloatSettings"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static languages:Languages.Text_Global_Settings}">
    <StackPanel Margin="5" Spacing="5">
        <controls:FASettingsExpander Header="{x:Static languages:Languages.Text_ProxyFloat_WindowPosition}"
                                   Description="{x:Static languages:Languages.Text_ProxyFloat_WindowPositionDescription}">
            <controls:FASettingsExpander.Footer>
                <ComboBox SelectionChanged="SavePosition" x:Name="PosBox">
                    <ComboBoxItem Content="{x:Static languages:Languages.Text_ProxyFloat_Position_TopLeft}" Tag="lt" />
                    <ComboBoxItem Content="{x:Static languages:Languages.Text_ProxyFloat_Position_TopRight}" Tag="rt" />
                    <ComboBoxItem Content="{x:Static languages:Languages.Text_ProxyFloat_Position_BottomLeft}" Tag="lb" />
                    <ComboBoxItem Content="{x:Static languages:Languages.Text_ProxyFloat_Position_BottomRight}"
                                  Tag="rb" />
                    <ComboBoxItem Content="{x:Static languages:Languages.Text_ProxyFloat_Position_TopCenter}" Tag="ct" />
                    <ComboBoxItem Content="{x:Static languages:Languages.Text_ProxyFloat_Position_BottomCenter}"
                                  Tag="cb" />
                </ComboBox>
            </controls:FASettingsExpander.Footer>
        </controls:FASettingsExpander>
        <controls:FASettingsExpander IsExpanded="True"
                                   Header="{x:Static languages:Languages.Text_ProxyFloat_ClickThrough}"
                                   Description="{x:Static languages:Languages.Text_ProxyFloat_ClickThroughDescription}">
            <controls:FASettingsExpander.Footer>
                <ToggleSwitch x:Name="ClickThroughSwitch" IsCheckedChanged="ClickThroughChanged" />
            </controls:FASettingsExpander.Footer>
            <controls:FAInfoBar Severity="Warning" IsOpen="True" Title="{x:Static languages:Languages.Caption_Warning}"
                              Message="{x:Static languages:Languages.Text_ProxyFloat_EnableClickThroughWarning}" />
        </controls:FASettingsExpander>
        <controls:FASettingsExpander Header="{x:Static languages:Languages.Text_ProxyFloat_ShowChart}"
                                   Description="{x:Static languages:Languages.Text_ProxyFloat_ShowChartDescription}">
            <controls:FASettingsExpander.Footer>
                <ToggleSwitch x:Name="ShowChartSwitch" IsCheckedChanged="ShowChartChanged" />
            </controls:FASettingsExpander.Footer>
        </controls:FASettingsExpander>
        <controls:FASettingsExpander Header="{x:Static languages:Languages.Text_ProxyFloat_Opacity}"
                                   Description="{x:Static languages:Languages.Text_ProxyFloat_OpacityDescription}">
            <controls:FASettingsExpander.Footer>
                <Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1" Width="160"
                        ValueChanged="OpacityChanged" />
            </controls:FASettingsExpander.Footer>
        </controls:FASettingsExpander>
    </StackPanel>
</Window>