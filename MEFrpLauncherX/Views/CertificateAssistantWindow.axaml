<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        xmlns:models="clr-namespace:MEFrpLauncherX.Core.Models;assembly=MEFrpLauncherX.Core"
        xmlns:core="clr-namespace:MEFrpLauncherX.Core;assembly=MEFrpLauncherX.Core"
        mc:Ignorable="d"
        d:DesignWidth="620" d:DesignHeight="720"
        Width="620" Height="720"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static languages:Languages.Text_Certificate_Title}"
        x:Class="MEFrpLauncherX.Views.CertificateAssistantWindow">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">

        <!-- 说明（始终可见，明确本机处理与 ME Frp 无关） -->
        <controls:FAInfoBar Grid.Row="0"
                          Severity="Informational"
                          IsClosable="False"
                          IsOpen="True"
                          Title="{x:Static languages:Languages.Text_Certificate_Title}"
                          Message="{x:Static languages:Languages.Text_Certificate_Intro}" />

        <ScrollViewer Grid.Row="1" AllowAutoHide="True" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">

                <!-- 环境选择 -->
                <controls:FASettingsExpander Header="{x:Static languages:Languages.Text_Certificate_Env_Staging}"
                                           IsExpanded="True">
                    <controls:FASettingsExpanderItem
                        Content="{x:Static languages:Languages.Text_Certificate_Description}">
                        <controls:FASettingsExpanderItem.Footer>
                            <ComboBox x:Name="EnvBox" MinWidth="180" SelectedIndex="0" SelectionChanged="EnvChanged">
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_Certificate_Env_Staging}" />
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_Certificate_Env_Production}" />
                            </ComboBox>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                </controls:FASettingsExpander>

                <controls:FAInfoBar x:Name="ProductionWarning"
                                  Severity="Warning"
                                  IsClosable="False"
                                  IsOpen="False"
                                  Title="{x:Static languages:Languages.Caption_Warning}"
                                  Message="{x:Static languages:Languages.Text_Certificate_Env_ProductionWarning}" />

                <!-- 域名与邮箱 -->
                <controls:FASettingsExpander Header="{x:Static languages:Languages.Text_Certificate_Domain}"
                                           IsExpanded="True">
                    <controls:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_Certificate_Domain}">
                        <controls:FASettingsExpanderItem.Footer>
                            <TextBox x:Name="DomainBox" MinWidth="260"
                                     PlaceholderText="{x:Static languages:Languages.Text_Certificate_DomainPlaceholder}" />
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_Certificate_AltNames}">
                        <controls:FASettingsExpanderItem.Footer>
                            <TextBox x:Name="AltNamesBox" MinWidth="260"
                                     PlaceholderText="{x:Static languages:Languages.Text_Certificate_AltNamesPlaceholder}" />
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_Certificate_Email}">
                        <controls:FASettingsExpanderItem.Footer>
                            <TextBox x:Name="EmailBox" MinWidth="260"
                                     PlaceholderText="{x:Static languages:Languages.Text_Certificate_EmailPlaceholder}" />
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                </controls:FASettingsExpander>

                <!-- 验证方式与 DNS 账户（26.4 阶段 B） -->
                <controls:FASettingsExpander Header="{x:Static languages:Languages.Text_Certificate_Mode}"
                                           IsExpanded="True">
                    <controls:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_Certificate_Mode}">
                        <controls:FASettingsExpanderItem.Footer>
                            <ComboBox x:Name="ModeBox" MinWidth="260" SelectedIndex="0" SelectionChanged="ModeChanged">
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_Certificate_Mode_DnsAccount}" />
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_Certificate_Mode_Manual}" />
                            </ComboBox>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem x:Name="DnsAccountItem"
                                                   Content="{x:Static languages:Languages.Text_Certificate_DnsAccount}">
                        <controls:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox x:Name="DnsAccountBox" MinWidth="220">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:DnsAccountSummary">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Provider, Converter={x:Static core:DnsProviderConverter.Instance}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="ManageDnsButton" Click="ManageDnsAccounts"
                                        Content="{x:Static languages:Languages.Text_Certificate_ManageDnsAccounts}" />
                            </StackPanel>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                </controls:FASettingsExpander>

                <controls:FAInfoBar x:Name="NoDnsAccountHint"
                                  Severity="Warning"
                                  IsClosable="False"
                                  IsOpen="False"
                                  Message="{x:Static languages:Languages.Text_Certificate_DnsAccountNone}" />

                <!-- 高级选项 -->
                <Expander Header="{x:Static languages:Languages.Text_Certificate_Advanced}"
                          IsExpanded="False">
                    <StackPanel Spacing="10">
                        <!-- 26.4：传播等待上限可调，与 lego 的 dns.propagation-timeout 参数同源 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static languages:Languages.Text_Certificate_PropagationTimeout}"
                                       TextWrapping="Wrap" />
                            <controls:FANumberBox x:Name="PropagationTimeoutBox"
                                                Minimum="60" Maximum="900"
                                                SmallChange="30" LargeChange="60"
                                                Value="300"
                                                SpinButtonPlacementMode="Inline"
                                                MinWidth="180"
                                                HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Static languages:Languages.Text_Certificate_PropagationTimeoutDescription}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="SkipPropagationCheck"
                                  Content="{x:Static languages:Languages.Text_Certificate_SkipPropagation}" />
                        <TextBlock Text="{x:Static languages:Languages.Text_Certificate_SkipPropagationWarning}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Expander>

                <!-- 本地证书（26.4）：列出已签发证书并支持删除 -->
                <controls:FASettingsExpander x:Name="LocalCertExpander"
                                           Header="{x:Static languages:Languages.Text_Certificate_LocalList}"
                                           IsExpanded="False">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="LocalCertEmptyText"
                                   Text="{x:Static languages:Languages.Text_Certificate_Empty}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <StackPanel x:Name="LocalCertList" Spacing="8" />
                    </StackPanel>
                </controls:FASettingsExpander>

                <!-- 进度 / 挑战信息 -->
                <controls:FASettingsExpander x:Name="ProgressExpander"
                                           Header="{x:Static languages:Languages.Text_Certificate_Start}"
                                           IsExpanded="True">
                    <StackPanel Spacing="8">
                        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="StageText" TextWrapping="Wrap" FontWeight="SemiBold" />

                        <StackPanel x:Name="ChallengePanel" Spacing="6" IsVisible="False">
                            <TextBlock Text="{x:Static languages:Languages.Text_Certificate_ChallengeHint}"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6"
                                  ColumnSpacing="6">
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                           Text="{x:Static languages:Languages.Text_Certificate_ChallengeHost}" />
                                <SelectableTextBlock Grid.Row="0" Grid.Column="1" x:Name="ChallengeHostText"
                                                     VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="{x:Static languages:Languages.Text_Global_Copy}"
                                        Click="CopyChallengeHost" />
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                           Text="{x:Static languages:Languages.Text_Certificate_ChallengeValue}" />
                                <SelectableTextBlock Grid.Row="1" Grid.Column="1" x:Name="ChallengeValueText"
                                                     VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Row="1" Grid.Column="2"
                                        Content="{x:Static languages:Languages.Text_Global_Copy}"
                                        Click="CopyChallengeValue" />
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsVisible="False" />

                        <!-- 已脱敏的运行日志 -->
                        <StackPanel x:Name="LogPanel" Spacing="4" IsVisible="False">
                            <TextBlock Text="{x:Static languages:Languages.Text_Certificate_Log}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static languages:Languages.Text_Certificate_LogHint}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBox x:Name="LogBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Height="140"
                                     FontFamily="{StaticResource Jbm}" />
                        </StackPanel>
                    </StackPanel>
                </controls:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>

        <!-- 操作区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="ViewDocumentsButton" Click="ViewDocuments"
                    Content="{x:Static languages:Languages.Text_About_HelpDocs}" />
            <Button x:Name="CopyPathButton" Click="CopyCertificatePath" IsVisible="False"
                    Content="{x:Static languages:Languages.Text_Global_Copy}" />
            <Button x:Name="UseForTunnelButton" Click="UseForTunnel" IsVisible="False"
                    Content="{x:Static languages:Languages.Text_Certificate_UseForTunnel}" />
            <Button x:Name="OpenDirButton" Click="OpenDirectory"
                    Content="{x:Static languages:Languages.Text_Certificate_OpenDirectory}" />
            <Button x:Name="ConfirmButton" Click="ConfirmChallenge" IsVisible="False"
                    Content="{x:Static languages:Languages.Text_Certificate_ConfirmAdded}" />
            <Button x:Name="StartButton" Classes="accent" Click="StartIssue"
                    Content="{x:Static languages:Languages.Text_Certificate_Start}" />
            <Button x:Name="CloseButton" Click="CloseWindow"
                    Content="{x:Static languages:Languages.Text_Global_Close}" />
        </StackPanel>
    </Grid>
</Window>