<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        xmlns:models="clr-namespace:MEFrpLauncherX.Core.Models;assembly=MEFrpLauncherX.Core"
        xmlns:viewModels="clr-namespace:MEFrpLauncherX.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="640" d:DesignHeight="640"
        Width="640" Height="640"
        WindowStartupLocation="CenterOwner"
        x:DataType="viewModels:DnsAccountsWindowViewModel"
        Title="{x:Static languages:Languages.Text_Dns_Title}"
        x:Class="MEFrpLauncherX.Views.DnsAccountsWindow">
    <Design.DataContext>
        <viewModels:DnsAccountsWindowViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">

        <!-- 说明：明确本机处理、不上传 -->
        <controls:FAInfoBar Grid.Row="0"
                          Severity="Informational"
                          IsClosable="False"
                          IsOpen="True"
                          Title="{x:Static languages:Languages.Text_Dns_Title}"
                          Message="{x:Static languages:Languages.Text_Dns_Intro}" />

        <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="12">

            <!-- 左：账户列表 -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <TextBlock Text="{x:Static languages:Languages.Text_Dns_Title}"
                           Theme="{StaticResource SubtitleTextBlockStyle}" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <!-- 编译绑定不继承窗口级 x:DataType，DataTemplate 必须自带 x:DataType，否则 AVLN2000 -->
                        <DataTemplate x:DataType="models:DnsAccountSummary">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProviderDisplayName}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding UpdatedAtText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1"
                           IsVisible="{Binding IsEmpty}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{x:Static languages:Languages.Text_Dns_Empty}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding AddCommand}"
                            Content="{x:Static languages:Languages.Text_Dns_Add}" />
                    <Button Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding IsDeleteEnabled}"
                            Content="{x:Static languages:Languages.Text_Dns_Delete}" />
                    <Button Command="{Binding SubmitProviderCommand}"
                            Content="{x:Static languages:Languages.Text_Dns_SubmitProvider}" />
                </StackPanel>
            </Grid>
            <!-- 右：编辑表单（字段表驱动） -->
            <ScrollViewer Grid.Column="1" AllowAutoHide="True" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <controls:FAInfoBar Severity="Warning"
                                      IsClosable="False"
                                      IsOpen="True"
                                      Message="{x:Static languages:Languages.Text_Dns_StoreHint}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static languages:Languages.Text_Dns_AccountName}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="NameBox"
                                 Text="{Binding AccountName}"
                                 PlaceholderText="{x:Static languages:Languages.Text_Dns_AccountNamePlaceholder}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static languages:Languages.Text_Dns_Provider}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ProviderNames}"
                                  SelectedIndex="{Binding SelectedProviderIndex}" />
                    </StackPanel>

                    <controls:FAInfoBar Severity="Informational"
                                      IsClosable="False"
                                      Message="{Binding PermissionHint}"
                                      IsOpen="{Binding IsPermissionHintOpen}" />

                    <!-- 动态字段容器：按服务商表驱动生成 -->
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DnsFieldViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBox Text="{Binding Value}"
                                             PasswordChar="{Binding PasswordChar}"
                                             PlaceholderText="{Binding Placeholder}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding OpenDocumentationCommand}"
                            IsEnabled="{Binding IsDocumentationEnabled}"
                            Content="{x:Static languages:Languages.Text_Dns_Documentation}" />

                    <TextBlock Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasValidation}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="accent" Command="{Binding SaveCommand}"
                    Content="{x:Static languages:Languages.Text_Dns_Save}" />
            <Button Command="{Binding CloseCommand}"
                    Content="{x:Static languages:Languages.Text_Global_Close}" />
        </StackPanel>
    </Grid>
</Window>
