<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MEFrpLauncherX.ViewModels"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="MEFrpLauncherX.Views.MainPageFrame"
             x:DataType="vm:MainPageFrameViewModel">

    <Design.DataContext>
        <vm:MainPageFrameViewModel />
    </Design.DataContext>
    <Grid Margin="10">
        <controls:NavigationView PaneDisplayMode="Auto" CompactPaneLength="33" IsPaneOpen="{Binding IsMenuOpen}"
                                 IsSettingsVisible="False" ItemInvoked="OnNavigationViewItemInvoked"
                                 Background="Transparent">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="HomeBtn" Tag="Home" IsSelected="True" IconSource="Home"
                                             Content="主页" />

                <controls:NavigationViewItem
                    x:Name="CreateProxyBtn" Tag="Create" IconSource="Add" Content="创建隧道" />
                <controls:NavigationViewItem Tag="Manage"
                                             x:Name="ManageProxyPageBtn" IconSource="AllApps" Content="隧道管理" />
                <controls:NavigationViewItem Tag="Monitoring"
                                             x:Name="NodesMonitoringPageBtn" Content="节点监控">
                    <controls:NavigationViewItem.IconSource>
                        <controls:FontIconSource
                            FontFamily="{StaticResource IconFont}"
                            Glyph="&#xead4;" FontWeight="Light" />
                    </controls:NavigationViewItem.IconSource>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Tag="User"
                                             x:Name="UserCenterPageBtn" IconSource="ContactInfo" Content="用户中心" />
                <controls:NavigationViewItemSeparator />
                <controls:NavigationViewItem Tag="Settings"
                                             x:Name="SettingsPageBtn" IconSource="Setting" Content="设置" />
                <controls:NavigationViewItem Tag="Theme"
                                             x:Name="ThemesPageBtn" IconSource="Library" Content="主题" />
                <controls:NavigationViewItem Tag="About"
                                             x:Name="AboutPageBtn" Content="关于">
                    <controls:NavigationViewItem.IconSource>
                        <controls:FontIconSource
                            FontFamily="{StaticResource IconFont}"
                            Glyph="&#xe60a;" />
                    </controls:NavigationViewItem.IconSource>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Tag="Update"
                                             x:Name="UpdatePageBtn" Content="更新">
                    <controls:NavigationViewItem.IconSource>
                        <controls:FontIconSource
                            FontFamily="{StaticResource IconFont}"
                            Glyph="&#xe68a;" />
                    </controls:NavigationViewItem.IconSource>
                </controls:NavigationViewItem>
                <controls:NavigationViewItemSeparator />
                <controls:NavigationViewItem Tag="Terminal"
                                             x:Name="TerminalPageBtn" Content="终端">
                    <controls:NavigationViewItem.IconSource>
                        <controls:FontIconSource
                            FontFamily="{StaticResource IconFont}"
                            FontSize="0.8"
                            Glyph="&#xf0f9;" />
                    </controls:NavigationViewItem.IconSource>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>
            <ContentControl Content="{Binding CurrentPage}" />
        </controls:NavigationView>

        <controls:ProgressRing
            IsIndeterminate="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding IsLoading}" />
    </Grid>
</UserControl>