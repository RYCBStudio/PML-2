<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:MEFrpLauncherX.ViewModels"
        xmlns:controls="clr-namespace:MEFrpLauncherX.Controls"
        xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:core="clr-namespace:MEFrpLauncherX.Core;assembly=MEFrpLauncherX.Core"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        WindowStartupLocation="CenterScreen"
        x:Class="MEFrpLauncherX.Views.ALPSettings"
        x:DataType="viewModels:ALPSettingsViewModel">
    <Window.Resources>
    </Window.Resources>
    <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="*,*">
        <controls1:ProgressRing Grid.ColumnSpan="3" Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />
        <TextBlock Grid.ColumnSpan="2" Text="{x:Static languages:Languages.Text_ALP_Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Theme="{StaticResource SubtitleTextBlockStyle}" />
        <Grid HorizontalAlignment="Center" Grid.Column="0" Grid.Row="1" RowDefinitions="Auto, *, Auto">
            <AutoCompleteBox x:Name="SearchBox" FilterMode="StartsWith" MinimumPrefixLength="1"
                             Text="{Binding SearchText}" Watermark="{x:Static languages:Languages.Text_ALP_SearchWatermark}" Width="200" />
            <ListBox SelectedItem="{Binding SelectedLeft}" Grid.Row="1"
                     ItemsSource="{Binding FilteredProxies}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto, Auto,Auto,Auto,Auto,Auto,Auto">
                            <controls1:InfoBadge Margin="0,5,10,0" HorizontalAlignment="Right"
                                                 Grid.RowSpan="7"
                                                 VerticalAlignment="Top"
                                                 Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                                 BorderThickness="-1"
                                                 FontSize="20"
                                                 FontWeight="Bold"
                                                 Foreground="Azure"
                                                 IsVisible="{Binding isBanned}">
                                <controls1:InfoBadge.IconSource>
                                    <controls1:FontIconSource FontFamily="{StaticResource GlobalFontFamily}"
                                                              Glyph="{x:Static languages:Languages.Text_Main_UserInfo_AccountStatus_Banned}" />
                                </controls1:InfoBadge.IconSource>
                            </controls1:InfoBadge>
                            <controls1:ProgressRing IsIndeterminate="True" Grid.RowSpan="7"
                                                    IsVisible="{Binding IsLoading}" />
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
                                <SelectableTextBlock Text="{Binding proxyName}"
                                                     Theme="{DynamicResource SubtitleTextBlockStyle}" />
                                <Label
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Theme="{StaticResource CaptionTextBlockStyle}"
                                    VerticalAlignment="Bottom"
                                    Content="{Binding proxyId, StringFormat='# {0}'}"
                                    FontFamily="{StaticResource GlobalFontFamily}" />
                            </StackPanel>
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10">
                                <controls1:InfoBadge>
                                    <controls1:InfoBadge.Background>
                                        <MultiBinding
                                            Converter="{x:Static controls:OnlineAndDisabledConverter.Instance}">
                                            <Binding Path="isOnline" />
                                            <Binding Path="isDisabled" />
                                        </MultiBinding>
                                    </controls1:InfoBadge.Background>
                                </controls1:InfoBadge>
                            </Grid>
                            <!-- Other fields -->
                            <StackPanel Grid.Row="1">
                                <StackPanel
                                    Margin="5"
                                    Orientation="Horizontal">
                                    <Label
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource GlobalFontFamily}"
                                        Classes.Normal="{Binding node, Converter={x:Static core:NodeNotFoundToBoolConverterReverse.Instance}}"
                                        Classes.Danger="{Binding node, Converter={x:Static core:NodeNotFoundToBoolConverter.Instance}}">
                                        <Label.Content>
                                            <MultiBinding>
                                                <Binding Path="node" />
                                                <Binding Path="nodeId" />
                                                <MultiBinding.StringFormat>
                                                    #{1} {0}
                                                </MultiBinding.StringFormat>
                                            </MultiBinding>
                                        </Label.Content>
                                    </Label>
                                </StackPanel>
                                <StackPanel
                                    Margin="5"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource GlobalFontFamily}"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding>
                                                <Binding Path="proxyType"
                                                         Converter="{x:Static core:LowerCaseToUpperCaseConverter.Instance}" />
                                                <Binding Path="localIp" />
                                                <Binding Path="localPort" />
                                                <MultiBinding.StringFormat>
                                                    [{0}] {1}:{2} →
                                                </MultiBinding.StringFormat>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding remotePort, StringFormat=' {0}'}"
                                               IsVisible="{Binding proxyType, Converter={x:Static core:ProxyTypeToBoolReverseConverter.Instance}}" />
                                    <TextBlock Text="{Binding domain, StringFormat=' {0}'}"
                                               IsVisible="{Binding proxyType, Converter={x:Static core:ProxyTypeToBoolConverter.Instance}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" HorizontalAlignment="Center" Content="{x:Static languages:Languages.Text_ALP_AddToQueue}"
                    Command="{Binding TransferSelectedProxyToRightCommand}" CommandParameter="{Binding SelectedLeft}" />
        </Grid>
        <Grid HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" RowDefinitions="Auto, *, Auto">
            <AutoCompleteBox x:Name="SearchBox1" FilterMode="StartsWith" MinimumPrefixLength="1"
                             Text="{Binding SearchText1}" Watermark="{x:Static languages:Languages.Text_ALP_SearchWatermark}" Width="200" />
            <ListBox x:Name="AutoLaunchList" SelectedItem="{Binding SelectedRight}" Grid.Row="1"
                     ItemsSource="{Binding AddedProxies}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:ALPControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" HorizontalAlignment="Center" Content="{x:Static languages:Languages.Text_ALP_RemoveFromQueue}"
                    Command="{Binding TransferSelectedProxyToLeftCommand}" CommandParameter="{Binding SelectedRight}" />
        </Grid>
        <StackPanel HorizontalAlignment="Center" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Spacing="10">
            <Button Content="{x:Static languages:Languages.Text_Global_Save}" Click="SaveSettings" Classes="accent" />
            <Button Content="{x:Static languages:Languages.Text_Global_Cancel}" Click="Close" />
        </StackPanel>
    </Grid>
</Window>