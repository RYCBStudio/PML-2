<windowing:AppWindow
    x:Class="MEFrpLauncherX.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:MEFrpLauncherX.Views"
    xmlns:core="clr-namespace:MEFrpLauncherX.Core;assembly=MEFrpLauncherX.Core"
    xmlns:msg="https://github.com/xiyaowong/Message.Avalonia"
    xmlns:windowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
    xmlns:viewModels="clr-namespace:MEFrpLauncherX.Core.ViewModels;assembly=MEFrpLauncherX.Core"
    Title="PML 2"
    Width="980"
    Height="600"
    Background="#2f000000"
    SystemDecorations="Full"
    x:Name="Window"
    Closing="Window_Closing"
    WindowStartupLocation="CenterScreen"
    x:DataType="viewModels:MainWindowViewModel"
    Icon="/Assets/meflx.png"
    mc:Ignorable="d">
    <Design.DataContext>
        <viewModels:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <Border x:Name="MainLayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1"
                Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
        <Image x:Name="MainBackground" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="0"
               IsVisible="False" />
        <Image x:Name="LoginBackground" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="-1"
               IsVisible="True"
               Source="/Assets/splash.png"
               Stretch="UniformToFill" />
        <Grid RowDefinitions="*,Auto" ZIndex="2">
            <ContentControl x:Name="MainContentControl"
                            FontFamily="{DynamicResource GlobalFontFamily}">
                <Border CornerRadius="8" BorderThickness="1" HorizontalAlignment="Right" Margin="10"
                        Padding="40,0,40,0"
                        Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <views:LoginPage
                        MinWidth="200"
                        Background="Transparent"
                        FontFamily="{DynamicResource GlobalFontFamily}" />
                </Border>
            </ContentControl>

            <TextBlock Margin="10,0,0,0" PropertyChanged="StatusBar_OnPropertyChanged" x:Name="StatusBar" Grid.Row="1"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       Text="{Binding AppMessage}"
                       IsVisible="{Binding AppMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ProgressBar Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,10,0,0"
                         FontFamily="{DynamicResource GlobalFontFamily}"
                         Value="{Binding Progress}"
                         IsVisible="{Binding Progress, Converter={x:Static core:ProgressToVisibilityConverter.Instance}}" />
        </Grid>
        <msg:MessageHost
            FontFamily="{DynamicResource GlobalFontFamily}" ZIndex="10" HostId="PML2_Msg" />
    </Panel>
</windowing:AppWindow>