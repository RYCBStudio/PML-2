<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Height="400"
        TransparencyLevelHint="Mica"
        x:Class="MEFrpLauncherX.Views.ConfigEditor"
        Title="">
    <Grid RowDefinitions="Auto,*">

        <StackPanel Margin="5" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" Theme="{StaticResource SubtitleTextBlockStyle}"
                       Text="{x:Static languages:Languages.Text_ConfigEditor_Title}"
                       FontWeight="Bold" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static languages:Languages.Text_Global_Type}" />
            <TextBlock VerticalAlignment="Center" x:Name="ConfigTypeTextBlock" />

            <controls:FACommandBar DefaultLabelPosition="Right">
                <controls:FACommandBar.PrimaryCommands>
                    <controls:FACommandBarButton VerticalContentAlignment="Center" Margin="8,0,0,0"
                                               Click="CloseButton_Click" IconSource="Cancel"
                                               Label="{x:Static languages:Languages.Text_ConfigEditor_CloseAndCancelLaunch}" />
                    <controls:FACommandBarButton Click="CopyButton_Click" IconSource="Copy"
                                               Label="{x:Static languages:Languages.Text_Global_Copy}" />
                    <controls:FACommandBarButton Click="SaveButton_Click" IconSource="Save"
                                               Label="{x:Static languages:Languages.Text_Global_Save}" />
                    <controls:FACommandBarButton Click="SaveAndRunButton_Click" IconSource="Next"
                                               Label="{x:Static languages:Languages.Text_ConfigEditor_SaveAndRun}" />
                </controls:FACommandBar.PrimaryCommands>
            </controls:FACommandBar>
        </StackPanel>

        <avaloniaEdit:TextEditor
            x:Name="CfgEditor"
            Grid.Row="1"
            FontFamily="{StaticResource Jbm}"
            FontSize="13"
            ShowLineNumbers="True"
            WordWrap="False" />
    </Grid>
</Window>