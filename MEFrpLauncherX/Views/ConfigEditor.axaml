<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Height="400"
        TransparencyLevelHint="Mica"
        x:Class="MEFrpLauncherX.Views.ConfigEditor"
        Title="">
    <Grid RowDefinitions="Auto,*">

        <StackPanel Margin="5" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" Theme="{StaticResource TitleTextBlockStyle}" Text="{x:Static languages:Languages.Text_ConfigEditor_Title}"
                       FontWeight="Bold" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static languages:Languages.Text_Global_Type}" />
            <TextBlock VerticalAlignment="Center" x:Name="ConfigTypeTextBlock" />


            <Button VerticalContentAlignment="Center" Margin="8,0,0,0" Click="CloseButton_Click" Content="{x:Static languages:Languages.Text_ConfigEditor_CloseAndCancelLaunch}" />
            <Button Click="CopyButton_Click" Content="{x:Static languages:Languages.Text_Global_Copy}" />
            <Button Click="SaveButton_Click" Content="{x:Static languages:Languages.Text_Global_Save}" />

            <Button Click="SaveAndRunButton_Click" Content="{x:Static languages:Languages.Text_ConfigEditor_SaveAndRun}" />
        </StackPanel>

        <avaloniaEdit:TextEditor
            x:Name="CfgEditor"
            Grid.Row="1"
            FontFamily="{StaticResource Jbm}"
            FontSize="13"
            ShowLineNumbers="True"
            WordWrap="False" />
    </Grid>
</Window>