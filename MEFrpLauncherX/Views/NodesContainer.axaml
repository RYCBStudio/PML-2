<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:MEFrpLauncherX.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:MEFrpLauncherX.ViewModels"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             x:Class="MEFrpLauncherX.Views.NodesContainer"
             x:DataType="viewModels:NodesContainerViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Classes="animated">

        <!-- Search and filter bar -->
        <Border Grid.Row="0"
                Margin="0,0,0,5"
                Padding="10">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBox Width="200" VerticalAlignment="Center"
                             Watermark="搜索节点"
                             FontFamily="{StaticResource GlobalFontFamily}"
                             Text="{Binding SearchText}" />
                    <ToggleButton x:Name="HelpBtn">
                        <ToggleButton.Content>
                            <controls:SymbolIcon Symbol="Help" />
                        </ToggleButton.Content>
                    </ToggleButton>
                    <controls:TeachingTip IsOpen="{Binding #HelpBtn.IsChecked, Mode=TwoWay}"
                                          Target="{Binding #HelpBtn}"
                                          Title="搜索帮助"
                                          IconSource="Help" >
                        <controls:TeachingTip.Content>
                            <StackPanel Spacing="3">
                                <TextBlock>无参数: 直接搜索名称</TextBlock>
                                <TextBlock>输入/d:&lt;KEYWORD&gt;以搜索描述</TextBlock>
                                <TextBlock>输入/pn:&lt;PINYIN&gt;以使用拼音搜索名称</TextBlock>
                                <TextBlock>输入/pd:&lt;PINYIN&gt;以使用拼音搜索描述</TextBlock>
                                <controls:InfoBar Severity="Warning" Title="已知性能警告" Message="使用拼音搜索将减慢搜索速度, 并造成程序假死。" IsOpen="True" IsClosable="False" />
                            </StackPanel>
                        </controls:TeachingTip.Content>
                        <controls:TeachingTip.CloseButtonContent>
                            <controls:SymbolIcon Symbol="Clear" />
                        </controls:TeachingTip.CloseButtonContent>
                    </controls:TeachingTip>
                </StackPanel>

                <CheckBox Margin="15,0,0,0"
                          Content="仅显示可建站节点" VerticalAlignment="Center"
                          FontFamily="{StaticResource GlobalFontFamily}"
                          IsChecked="{Binding FilterCanBuildSite}" />
                <CheckBox Margin="15,0,0,0"
                          Content="仅显示允许大流量节点" VerticalAlignment="Center"
                          FontFamily="{StaticResource GlobalFontFamily}"
                          IsChecked="{Binding FilterAllowHighTraffic}" />
                <CheckBox Margin="15,0,0,0"
                          Content="仅显示未过载节点" VerticalAlignment="Center"
                          FontFamily="{StaticResource GlobalFontFamily}"
                          IsChecked="{Binding FilterNotOverLoaded}" />
            </StackPanel>
        </Border>

        <!-- Region tabs -->
        <TabStrip Grid.Row="1"
                  Margin="0,0,0,10"
                  FontFamily="{StaticResource GlobalFontFamily}"
                  SelectedIndex="0"
                  SelectedItem="{Binding SelectedRegion, Mode=TwoWay}">
            <TabStripItem Content="全部" Tag="all" />
            <TabStripItem Content="中国大陆" Tag="cn" />
            <TabStripItem Content="港澳台" Tag="cnos" />
            <TabStripItem Content="海外" Tag="oversea" />
        </TabStrip>

        <!-- Node list -->
        <controls:ProgressRing Grid.Row="2"
                               IsIndeterminate="True"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoading}" />
        <ListBox Grid.Row="2"
                 x:Name="Nodes"
                 Background="Transparent"
                 ItemsSource="{Binding FilteredNodes}"
                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                 IsVisible="{Binding !IsLoading}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ctrls:TunnelNodeControl x:Name="tnc"
                                             VerticalAlignment="Center"
                                             Width="250"
                                             Height="240"
                                             DataContext="{Binding}"
                                             IsEnabled="{Binding IsNotOverloaded, DataType=ctrls:TunnelNodeViewModel}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <!-- 关键点：将样式绑定到当前项（TunnelNodeViewModel） -->
                    <Setter Property="IsEnabled" Value="{Binding IsNotOverloaded, DataType=ctrls:TunnelNodeViewModel}" />
                    <Setter Property="IsSelected"
                            Value="{Binding IsSelected, Mode=TwoWay, DataType=ctrls:TunnelNodeViewModel}" />
                </Style>

            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>