<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:MEFrpLauncherX.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:MEFrpLauncherX.ViewModels"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:virtualizingWrapPanel="clr-namespace:MEFrpLauncherX.Controls.VirtualizingWrapPanel"
             xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             x:Class="MEFrpLauncherX.Views.NodesContainer"
             x:DataType="viewModels:NodesContainerViewModel">
    <Design.DataContext>
        <viewModels:NodesContainerViewModel></viewModels:NodesContainerViewModel>
    </Design.DataContext>
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Search and filter bar -->
        <Border Grid.Row="0"
                Margin="0,0,0,5"
                Padding="10">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBox Width="200" VerticalAlignment="Center"
                             Watermark="{x:Static languages:Languages.Text_NodesContainer_SearchNodes}"
                             FontFamily="{StaticResource GlobalFontFamily}"
                             Text="{Binding SearchText}" />
                    <ToggleButton x:Name="HelpBtn">
                        <ToggleButton.Content>
                            <controls:SymbolIcon Symbol="Help" />
                        </ToggleButton.Content>
                    </ToggleButton>
                    <controls:TeachingTip IsOpen="{Binding #HelpBtn.IsChecked, Mode=TwoWay}"
                                          Target="{Binding #HelpBtn}"
                                          Title="{x:Static languages:Languages.Text_PluginList_SearchHelp}"
                                          IconSource="Help">
                        <controls:TeachingTip.Content>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Static languages:Languages.Text_NodesContainer_HelpNoParams}" />
                                <TextBlock Text="{x:Static languages:Languages.Text_NodesContainer_HelpDescSearch}" />
                                <TextBlock Text="{x:Static languages:Languages.Text_NodesContainer_HelpPinyinName}" />
                                <TextBlock Text="{x:Static languages:Languages.Text_NodesContainer_HelpPinyinDesc}" />
                                <controls:InfoBar Severity="Warning" Title="{x:Static languages:Languages.Text_NodesContainer_PerformanceWarningTitle}" Message="{x:Static languages:Languages.Text_NodesContainer_PerformanceWarningMessage}"
                                                  IsOpen="True" IsClosable="False" />
                            </StackPanel>
                        </controls:TeachingTip.Content>
                        <controls:TeachingTip.CloseButtonContent>
                            <controls:SymbolIcon Symbol="Clear" />
                        </controls:TeachingTip.CloseButtonContent>
                    </controls:TeachingTip>
                </StackPanel>

                <CheckBox Margin="15,0,0,0"
                          Content="{x:Static languages:Languages.Text_NodesContainer_OnlySiteBuildable}" VerticalAlignment="Center"
                          FontFamily="{StaticResource GlobalFontFamily}"
                          IsChecked="{Binding FilterCanBuildSite}" />
                <CheckBox Margin="15,0,0,0"
                          Content="{x:Static languages:Languages.Text_NodesContainer_OnlyHighTraffic}" VerticalAlignment="Center"
                          FontFamily="{StaticResource GlobalFontFamily}"
                          IsChecked="{Binding FilterAllowHighTraffic}" />
                <CheckBox Margin="15,0,0,0"
                          Content="{x:Static languages:Languages.Text_NodesContainer_OnlyNotOverloaded}" VerticalAlignment="Center"
                          FontFamily="{StaticResource GlobalFontFamily}"
                          IsChecked="{Binding FilterNotOverLoaded}" />
            </StackPanel>
        </Border>

        <!-- Region tabs -->
        <TabStrip Grid.Row="1" Theme="{StaticResource AlternateTabStripTheme}"
                  ItemContainerTheme="{StaticResource AlternateTabStripItemTheme}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,10"
                  FontFamily="{StaticResource GlobalFontFamily}"
                  SelectedIndex="1"
                  SelectedItem="{Binding SelectedRegion, Mode=TwoWay}">
            <TabStripItem Content="{x:Static languages:Languages.Text_NodesContainer_Region_All}" Tag="all" />
            <TabStripItem Content="{x:Static languages:Languages.Text_NodesContainer_Region_MainlandChina}" Tag="cn" />
            <TabStripItem Content="{x:Static languages:Languages.Text_NodesContainer_Region_HKMOTW}" Tag="cnos" />
            <TabStripItem Content="{x:Static languages:Languages.Text_NodesContainer_Region_Overseas}" Tag="oversea" />
        </TabStrip>

        <!-- Node list -->
        <controls:ProgressRing Grid.Row="2"
                               IsIndeterminate="True"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5"
                               IsVisible="{Binding IsLoading}">
            <controls:ProgressRing.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </controls:ProgressRing.RenderTransform>
        </controls:ProgressRing>
        <ListBox Grid.Row="2"
                 x:Name="Nodes"
                 Background="Transparent"
                 ItemsSource="{Binding FilteredNodes, Mode=OneWay}"
                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                 IsVisible="{Binding !IsLoading}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- <WrapPanel Orientation="Horizontal" ItemWidth="260" -->
                    <!--            ItemHeight="250" ItemSpacing="2" LineSpacing="2" /> -->
                    <virtualizingWrapPanel:SVirtualizingWrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ctrls:TunnelNodeControl x:Name="tnc"
                                             Margin="2" Padding="2" CornerRadius="8"
                                             Classes="animated"
                                             VerticalAlignment="Center"
                                             Width="250"
                                             Height="240"
                                             DataContext="{Binding}"
                                             IsEnabled="{Binding IsNotOverloaded}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <!-- ListBox 已通过 SelectedItem 管理选中状态，无需额外绑 Setter -->
                    <!-- IsEnabled 已由 TunnelNodeControl 上的绑定控制 -->
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>