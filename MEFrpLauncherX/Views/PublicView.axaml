<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MEFrpLauncherX.Controls"
             xmlns:views="clr-namespace:MEFrpLauncherX.Views"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="100"
             x:Class="MEFrpLauncherX.Views.PublicView"
             x:DataType="views:PublicView">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="5">
        <controls:PublicViewItem
            x:Name="Node"
            Description="节点数"
            TargetNumber="{Binding NodesCount}" />
        <controls:PublicViewItem
            x:Name="Users"
            Description="用户数"
            TargetNumber="{Binding UsersCount}" />
        <controls:PublicViewItem
            x:Name="Proxies"
            Description="隧道数"
            TargetNumber="{Binding ProxiesCount}" />
        <controls:PublicViewItem
            x:Name="Traffics"
            Description="承载流量(TB)"
            TargetNumber="{Binding Traffic, Converter={x:Static views:TrafficToTargetNumberConverter.Instance}}" />
    </WrapPanel>
</UserControl>