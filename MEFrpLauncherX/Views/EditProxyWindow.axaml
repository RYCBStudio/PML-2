<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pml2="clr-namespace:MEFrpLauncherX.Controls"
        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica"
        x:Class="MEFrpLauncherX.Views.EditProxyWindow"
        Width="500"
        Height="700"
        Title="{x:Static languages:Languages.Text_EditProxy_Title}">
    <Grid RowDefinitions="*, Auto" RowSpacing="5">
        <ScrollViewer x:Name="MainContainer">
            <StackPanel x:Name="OperationPanel" x:DataType="pml2:CreateProxyViewModel">
                <fa:FASettingsExpander Header="{x:Static languages:Languages.Text_CreateProxy_BasicSettings}"
                                     IconSource="AllApps"
                                     Description="{x:Static languages:Languages.Text_CreateProxy_BasicSettingsDescription}">
                    <fa:FASettingsExpanderItem Description="{x:Static languages:Languages.Text_CreateProxy_ProxyNamePlaceholder}">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_ProxyName}" IsRequired="True" />
                        <fa:FASettingsExpanderItem.Footer>
                            <TextBox
                                x:Name="ProxyNameBox"
                                Margin="5"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_ProxyNamePlaceholder}"
                                Text="{Binding ProxyName}" />

                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Description="{x:Static languages:Languages.Text_CreateProxy_LocalAddressPlaceholder}">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_LocalAddress}" IsRequired="True" />
                        <fa:FASettingsExpanderItem.Footer>
                            <TextBox
                                x:Name="LocalAddressBox"
                                Margin="5"
                                PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_LocalAddressPlaceholder}"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                Text="{Binding LocalAddress}" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem>
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_LocalPort}" IsRequired="True" />
                        <fa:FASettingsExpanderItem.Footer>
                            <fa:FANumberBox
                                x:Name="LocalPortNudBox"
                                Margin="5"
                                SpinButtonPlacementMode="Inline"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                Maximum="65535"
                                Minimum="0"
                                Value="{Binding LocalPort}" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="RemotePortGrid">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_RemotePort}" IsRequired="True" />
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <fa:FANumberBox
                                    x:Name="RemotePortNudBox"
                                    Margin="5"
                                    SpinButtonPlacementMode="Inline"
                                    FontFamily="{StaticResource GlobalFontFamily}"
                                    Maximum="65535"
                                    Minimum="0"
                                    Value="{Binding RemotePort}" />
                                <Panel VerticalAlignment="Center">
                                    <Button
                                        x:Name="GetRemotePort"
                                        Margin="5"
                                        Click="GetRemotePort_Click"
                                        Content="{x:Static languages:Languages.Text_CreateProxy_GetRemotePort}"
                                        FontFamily="{StaticResource GlobalFontFamily}" />
                                    <fa:FAProgressRing IsVisible="False" IsIndeterminate="True" x:Name="Loading" />
                                </Panel>
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="SourceProtocolFASettingsExpanderItemForHttp" IsVisible="False">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_SourceProtocol}" IsRequired="False" />
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <RadioButton GroupName="http" x:Name="SameAsHttp">
                                    <TextBlock VerticalAlignment="Bottom" Text="{x:Static languages:Languages.Text_CreateProxy_SameAsHttp}" />
                                </RadioButton>
                                <RadioButton GroupName="http" x:Name="Http2Https">
                                    <TextBlock VerticalAlignment="Bottom">HTTPS</TextBlock>
                                </RadioButton>
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="SourceProtocolFASettingsExpanderItemForHttps" IsVisible="False">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_SourceProtocol}" IsRequired="False" />
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <RadioButton GroupName="https" x:Name="SameAsHttps">
                                    <TextBlock VerticalAlignment="Bottom" Text="{x:Static languages:Languages.Text_CreateProxy_SameAsHttps}" />
                                </RadioButton>
                                <RadioButton GroupName="https" x:Name="Https2Http">
                                    <TextBlock VerticalAlignment="Bottom">HTTP</TextBlock>
                                </RadioButton>
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="CertificateSettingsForPath" IsVisible="False" Content="{x:Static languages:Languages.Text_CreateProxy_SslCertPath}"
                                             Description="{x:Static languages:Languages.Text_CreateProxy_SslPathDescription}">
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBox x:Name="SslPathBox" PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_SslCertPathPlaceholder}" />
                                <!-- 26.4：从证书助手选择已签发的证书（与创建页一致） -->
                                <Button Click="PickCertificateFromAssistant"
                                        Content="{x:Static languages:Languages.Text_Certificate_SelectForTunnel}" />
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem x:Name="CertificateSettingsForPrivateKey" IsVisible="False"
                                             Content="{x:Static languages:Languages.Text_CreateProxy_SslKeyPath}" Description="{x:Static languages:Languages.Text_CreateProxy_SslPathDescription}">
                        <fa:FASettingsExpanderItem.Footer>
                            <TextBox x:Name="SslKeyBox" PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_SslKeyPathPlaceholder}" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem
                        x:Name="RemoteAddressStackPanel" Description="{x:Static languages:Languages.Text_CreateProxy_BindDomainsDescription}"
                        IsVisible="False">
                        <pml2:RequiredField Label="{x:Static languages:Languages.Text_CreateProxy_BindDomains}" IsRequired="False" />
                        <fa:FASettingsExpanderItem.Footer>
                            <Button Click="EditDomains">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <fa:FASymbolIcon Symbol="Edit" />
                                        <TextBlock Text="{x:Static languages:Languages.Text_Global_Edit}" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander Header="{x:Static languages:Languages.Text_CreateProxy_AdvancedSettings}"
                                     IconSource="Code"
                                     Description="{x:Static languages:Languages.Text_CreateProxy_AdvancedSettingsDescription}">
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_SecurityOptions}" x:Name="SecurityOptionsFASettingsExpander"
                                             IsVisible="False">
                        <fa:FASettingsExpanderItem.Footer>
                            <ComboBox x:Name="SecurityOptionsSelect">
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_CreateProxy_Disabled}" />
                                <ComboBoxItem>HTTP Basic Auth</ComboBoxItem>
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_CreateProxy_AccessKey}" />
                            </ComboBox>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_AccessKey}" Description="{x:Static languages:Languages.Text_CreateProxy_AccessKeyDescription}"
                                             IsVisible="{Binding #SecurityOptionsSelect.SelectedIndex, Converter={x:Static pml2:SelectIndexToVisibleConverterReverse.Instance}}">
                        <fa:FASettingsExpanderItem.Footer>
                            <TextBox
                                x:Name="AccessKeyBox"
                                Margin="5"
                                PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_AccessKeyDescription}"
                                FontFamily="{StaticResource GlobalFontFamily}" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="HTTP Basic Auth" Description="{x:Static languages:Languages.Text_CreateProxy_HttpBasicAuthDescription}"
                                             IsVisible="{Binding #SecurityOptionsSelect.SelectedIndex, Converter={x:Static pml2:SelectIndexToVisibleConverter.Instance}}">
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBox
                                    x:Name="HTTPBasicAuthNameBox"
                                    Margin="5"
                                    PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_UsernamePlaceholder}"
                                    FontFamily="{StaticResource GlobalFontFamily}" />
                                <TextBox
                                    x:Name="HTTPBasicAuthPwdBox"
                                    Margin="5"
                                    PlaceholderText="{x:Static languages:Languages.Text_CreateProxy_PasswordPlaceholder}"
                                    RevealPassword="{Binding #RevealPwdToggleBtn.IsChecked}"
                                    PasswordChar="•"
                                    FontFamily="{StaticResource GlobalFontFamily}" />
                                <ToggleButton x:Name="RevealPwdToggleBtn" HorizontalAlignment="Right"
                                              Margin="0 00 12 0">
                                    <ToggleButton.Content>
                                        <fa:FAFontIcon Glyph="&#xF78D;"
                                                     FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </ToggleButton.Content>
                                </ToggleButton>
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>

                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_TransmissionProtocol}"
                                             Description="{x:Static languages:Languages.Text_CreateProxy_TransmissionProtocolDescription}">
                        <fa:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <RadioButton GroupName="TransmissionProtocol" Content="TCP" IsChecked="True"
                                             x:Name="TpTcpRb" />
                                <RadioButton GroupName="TransmissionProtocol" Content="QUIC" x:Name="TpQuicRb" />
                            </StackPanel>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_CustomRequestHeaders}" IsVisible="False" x:Name="CustomRequestHeaderSettings">
                        <fa:FASettingsExpanderItem.Footer>
                            <Button Click="EditRequestHeaders">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <fa:FASymbolIcon Symbol="Edit" />
                                        <TextBlock Text="{x:Static languages:Languages.Text_Global_Edit}" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_CustomResponseHeaders}" IsVisible="False" x:Name="CustomResponseHeaderSettings">
                        <fa:FASettingsExpanderItem.Footer>
                            <Button Click="EditResponseHeaders">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <fa:FASymbolIcon Symbol="Edit" />
                                        <TextBlock Text="{x:Static languages:Languages.Text_Global_Edit}" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="Locations" Description="{x:Static languages:Languages.Text_CreateProxy_LocationsDescription}" IsVisible="False"
                                             x:Name="LocationSettings">
                        <fa:FASettingsExpanderItem.Footer>
                            <Button Click="EditLocations">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <fa:FASymbolIcon Symbol="Edit" />
                                        <TextBlock Text="{x:Static languages:Languages.Text_Global_Edit}" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>

                    <fa:FASettingsExpanderItem Content="Proxy Protocol">
                        <fa:FASettingsExpanderItem.Footer>
                            <ComboBox
                                x:Name="ProxyProtocolCbBox"
                                Margin="5"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                SelectedIndex="0">
                                <ComboBoxItem Content="{x:Static languages:Languages.Text_CreateProxy_NotEnabled}" />
                                <ComboBoxItem Content="v1" />
                                <ComboBoxItem Content="v2" />
                            </ComboBox>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_EnableEncryption}">
                        <fa:FASettingsExpanderItem.Footer>
                            <ToggleSwitch
                                x:Name="EnableCryptoCBox"
                                Margin="5,0,5,0"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                OffContent="{x:Static languages:Languages.Text_Global_No}"
                                OnContent="{x:Static languages:Languages.Text_Global_Yes}"
                                IsChecked="False" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem Content="{x:Static languages:Languages.Text_CreateProxy_EnableCompression}">
                        <fa:FASettingsExpanderItem.Footer>
                            <ToggleSwitch
                                x:Name="EnableCompressCBox"
                                Margin="5,0,5,0"
                                OffContent="{x:Static languages:Languages.Text_Global_No}"
                                OnContent="{x:Static languages:Languages.Text_Global_Yes}"
                                FontFamily="{StaticResource GlobalFontFamily}"
                                IsChecked="False" />
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                </fa:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button Classes="accent" Content="{x:Static languages:Languages.Text_Global_Save}" Click="OnSaveClicked" />
            <Button Content="{x:Static languages:Languages.Text_Global_Cancel}" Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Window>