<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Height="400"
        TransparencyLevelHint="Mica"
        CanResize="False"
        Closing="Window_OnClosing"
        x:Class="MEFrpLauncherX.Views.ALPConfigEditor"
        Title="{x:Static languages:Languages.Text_ConfigEditor_Title}">
    <Grid RowDefinitions="Auto, *" RowSpacing="4" Margin="3" Classes="animated">
        <DockPanel>
            <controls:InfoBar x:Name="UnSavedTip" DockPanel.Dock="Right" IconSource="SaveLocal" IsOpen="True"
                              Severity="Warning" IsClosable="False"
                              Message="{x:Static languages:Languages.Text_ConfigEditor_UnsavedChanges}" />
            <StackPanel Orientation="Horizontal" Spacing="5">
                <controls:CommandBar DefaultLabelPosition="Right">
                    <controls:CommandBar.PrimaryCommands>
                        <controls:CommandBarButton VerticalAlignment="Center" Click="OnPasteClicked"
                                                   Label="{x:Static languages:Languages.Text_Global_Paste}" IconSource="Paste" />
                        <controls:CommandBarButton VerticalAlignment="Center" Click="OnSaveClicked" Label="{x:Static languages:Languages.Text_Global_Save}"
                                                   IconSource="Save" />
                        <controls:CommandBarButton VerticalAlignment="Center" Click="OnCancelClicked" Label="{x:Static languages:Languages.Text_Global_Cancel}"
                                                   IconSource="Cancel" />
                        <controls:CommandBarSeparator />
                        <controls:CommandBarElementContainer Margin="10 0  0 0">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="{x:Static languages:Languages.Text_ConfigEditor_FileType}" />
                                <ComboBox VerticalAlignment="Center" x:Name="FileTypeComboBox"
                                          SelectionChanged="ChangeSyntaxHighlight">
                                    <ComboBoxItem Content="JSON" />
                                    <ComboBoxItem Content="YAML" />
                                    <ComboBoxItem Content="TOML" />
                                    <ComboBoxItem Content="INI" />
                                </ComboBox>
                            </StackPanel>
                        </controls:CommandBarElementContainer>
                    </controls:CommandBar.PrimaryCommands>
                </controls:CommandBar>
            </StackPanel>
        </DockPanel>
        <avaloniaEdit:TextEditor ShowLineNumbers="True" x:Name="ConfigEdit" Grid.Row="1" />
    </Grid>
</Window>