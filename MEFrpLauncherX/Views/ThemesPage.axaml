<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MEFrpLauncherX.ViewModels"
             xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MEFrpLauncherX.Views.ThemesPage"
             x:DataType="vm:ThemesPageViewModel">
    <Design.DataContext>
        <vm:ThemesPageViewModel />
    </Design.DataContext>

    <StackPanel Margin="10" Spacing="10" Classes="animated-intro">
        <TextBlock Theme="{StaticResource TitleTextBlockStyle}" Text="{x:Static languages:Languages.Text_Themes_Title}" />

        <TabControl Classes="compact">
            <TabItem Header="{x:Static languages:Languages.Text_Themes_LocalThemes}">
                <Grid RowDefinitions="Auto, *">
                    <controls:FACommandBar DefaultLabelPosition="Right" Classes="animated">
                        <controls:FACommandBar.PrimaryCommands>
                            <controls:FACommandBarButton IconSource="Refresh" Label="{x:Static languages:Languages.Text_Global_Refresh}"
                                                       Command="{Binding RefreshLocalThemesCommand}" />
                            <controls:FACommandBarButton IconSource="Add" Label="{x:Static languages:Languages.Text_Themes_New}"
                                                       Command="{Binding AddLocalThemeCommand}" />
                            <controls:FACommandBarButton IconSource="Checkmark" Label="{x:Static languages:Languages.Text_Themes_ApplySelected}"
                                                       Command="{Binding ApplyLocalThemeCommand}" />
                            <controls:FACommandBarButton IconSource="Edit" Label="{x:Static languages:Languages.Text_Themes_EditSelected}"
                                                       Command="{Binding EditLocalThemeCommand}" />
                            <controls:FACommandBarButton IconSource="Delete" Label="{x:Static languages:Languages.Text_Themes_DeleteSelected}"
                                                       Command="{Binding DeleteLocalThemeCommand}" />
                            <controls:FACommandBarButton IconSource="OpenFile" Label="{x:Static languages:Languages.Text_Themes_PackageSelected}"
                                                       Command="{Binding PackageLocalThemeCommand}" />
                            <controls:FACommandBarButton Label="{x:Static languages:Languages.Text_Themes_Import}" IconSource="Import"
                                                       Command="{Binding ImportThemeCommand}" />
                            <controls:FACommandBarButton Label="{x:Static languages:Languages.Text_Themes_RestoreDefault}" IconSource="Undo"
                                                       Command="{Binding RestoreDefaultThemeCommand}" />
                            <controls:FACommandBarButton Label="{x:Static languages:Languages.Text_Themes_OpenDocs}" IconSource="Help"
                                                       Command="{Binding OpenDocumentationCommand}" />
                        </controls:FACommandBar.PrimaryCommands>
                    </controls:FACommandBar>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LocalThemes}"
                             SelectedItem="{Binding SelectedLocalTheme}"
                             Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, *" Classes="animated">
                                    <Image Grid.Column="0" Width="64" Height="64" Source="{Binding PreviewImage}"
                                           Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Author}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding Version}" FontSize="10"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static languages:Languages.Text_Themes_OnlineThemes}">
                <Grid RowDefinitions="Auto, Auto, *">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingOnlineThemes}" Width="100" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsDownloading}" Width="100" />
                    </StackPanel>
                    <controls:FACommandBar DefaultLabelPosition="Right" Classes="animated">
                        <controls:FACommandBar.PrimaryCommands>
                            <controls:FACommandBarButton Label="{x:Static languages:Languages.Text_Global_Refresh}" IconSource="Refresh"
                                                       Command="{Binding FetchOnlineThemesCommand}"
                                                       IsEnabled="{Binding !IsLoadingOnlineThemes}" />
                            <controls:FACommandBarButton Label="{x:Static languages:Languages.Text_Themes_DownloadSelected}" IconSource="Download"
                                                       Command="{Binding DownloadThemeCommand}"
                                                       IsEnabled="{Binding !IsDownloading}" />
                            <controls:FACommandBarElementContainer>
                                <TextBox PlaceholderText="{x:Static languages:Languages.Text_Themes_Search}" MaxHeight="10" MinWidth="200" Text="{Binding SearchText}" />
                            </controls:FACommandBarElementContainer>
                        </controls:FACommandBar.PrimaryCommands>
                    </controls:FACommandBar>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredOnlineThemes}"
                             SelectedItem="{Binding SelectedOnlineTheme}"
                             Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, *" Classes="animated">
                                    <Image Grid.Column="0" Width="64" Height="64"
                                           asyncImageLoader:ImageLoader.Source="{Binding PreviewImageUrl}"
                                           Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Author}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Version}" FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>