<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:MEFrpLauncherX.ViewModels"
             xmlns:controls="clr-namespace:MEFrpLauncherX.Controls"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MEFrpLauncherX.Views.CreateProxyGuide"
             x:DataType="viewModels:CreateProxyGuideViewModel">
    <Design.DataContext>
        <viewModels:CreateProxyGuideViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto, Auto, *" Margin="10" RowSpacing="5">
        <TextBlock FontFamily="{StaticResource GlobalFontFamily}"
                   Theme="{StaticResource SubtitleTextBlockStyle}" Text="{x:Static languages:Languages.Text_Proxy_Guide_Title}" />
        <controls:TypingControl Grid.Row="1" Text="{x:Static languages:Languages.Text_Proxy_Guide_Welcome}">
            <controls:TypingControl.Styles>
                <Style>
                    <Style.Animations>
                        <Animation Easing="SineEaseIn" Duration="0:0:0.5">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"></Setter>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </controls:TypingControl.Styles>
        </controls:TypingControl>
        <ListBox Grid.Row="2" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}"
                 IsVisible="{Binding HasTemplates}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="5">
                        <DockPanel HorizontalSpacing="5">
                            <ContentControl
                                Content="{Binding Icon, Converter={x:Static viewModels:PackIconToControlConverter.Instance}}" />
                            <TextBlock Text="{Binding Name}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Description}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <!-- 无可用模板插件（create-proxy-template）时显示空态提示 -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding !HasTemplates}">
            <TextBlock Text="{x:Static languages:Languages.Text_Proxy_Guide_NoTemplates}"
                       TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Center"
                       FontFamily="{StaticResource GlobalFontFamily}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>