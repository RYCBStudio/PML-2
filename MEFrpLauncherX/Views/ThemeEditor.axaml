<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MEFrpLauncherX.ViewModels"
        xmlns:views="clr-namespace:MEFrpLauncherX.Views"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:controls1="clr-namespace:MEFrpLauncherX.Controls"
        xmlns:languages="clr-namespace:MEFrpLauncherX.Core.Languages;assembly=MEFrpLauncherX.Core"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MEFrpLauncherX.Views.ThemeEditor"
        Title="{x:Static languages:Languages.Text_ThemeEditor_Title}"
        Width="900"
        Height="700"
        MinWidth="700"
        MinHeight="500">

    <Design.DataContext>
        <viewModels:ThemeEditorViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部工具栏 -->
        <controls:CommandBar DefaultLabelPosition="Right">
            <controls:CommandBar.PrimaryCommands>
                <controls:CommandBarButton Command="{Binding SaveThemeCommand}" Label="{x:Static languages:Languages.Text_ThemeEditor_SaveTheme}"
                                           IconSource="Save">
                </controls:CommandBarButton>
                <controls:CommandBarButton Command="{Binding AddColorCommand}" Label="{x:Static languages:Languages.Text_ThemeEditor_AddColor}" IconSource="Add">
                </controls:CommandBarButton>
                <controls:CommandBarButton Command="{Binding RemoveColorCommand}" Label="{x:Static languages:Languages.Text_ThemeEditor_RemoveColor}" IconSource="Remove"
                                           IsEnabled="{Binding CanRemoveColor}">
                </controls:CommandBarButton>
            </controls:CommandBar.PrimaryCommands>
        </controls:CommandBar>

        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="10" Spacing="15">

                <!-- 基本信息 -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <controls1:IconContent Label="{x:Static languages:Languages.Text_ThemeEditor_BasicInfo}" Symbol="ImageAltText"></controls1:IconContent>
                    </Expander.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static languages:Languages.Text_ThemeEditor_ThemeName}" VerticalAlignment="Center" Margin="0,5" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="5" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static languages:Languages.Text_ThemeEditor_Author}" VerticalAlignment="Center" Margin="10,5,0,5" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Author}" Margin="5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static languages:Languages.Text_ThemeEditor_Version}" VerticalAlignment="Center" Margin="0,5" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Version}" Margin="5" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static languages:Languages.Text_ThemeEditor_PreviewImage}" VerticalAlignment="Center"
                                   Margin="10,5,0,5" />
                        <Image Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" Source="{Binding PreviewImage}"
                               MaxHeight="128">
                        </Image>
                        <Button Grid.Row="2" Grid.Column="2" Content="{x:Static languages:Languages.Text_ThemeEditor_SelectImage}"
                                Command="{Binding BrowsePreviewImageCommand}" Margin="5" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static languages:Languages.Text_ThemeEditor_Description}" VerticalAlignment="Top" Margin="0,5" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description}"
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="5" />
                    </Grid>
                </Expander>

                <!-- 背景设置 -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <controls1:IconContent Label="{x:Static languages:Languages.Text_ThemeEditor_BackgroundSettings}" Symbol="Image" />
                    </Expander.Header>
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="10" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton Content="{x:Static languages:Languages.Text_ThemeEditor_SolidColorBackground}" GroupName="BackgroundTypes"
                                         IsChecked="{Binding IsSolidColorBackground}" />
                            <RadioButton Content="{x:Static languages:Languages.Text_ThemeEditor_ImageBackground}" GroupName="BackgroundTypes"
                                         IsChecked="{Binding IsImageBackground}" />
                        </StackPanel>

                        <!-- 纯色背景 -->
                        <StackPanel Grid.Row="1" IsVisible="{Binding IsSolidColorBackground}" Orientation="Horizontal"
                                    Spacing="5">
                            <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_BackgroundColor}" Margin="0,5" />
                            <TextBox Text="{Binding BackgroundColor}" Width="120" />
                            <ColorPicker Color="{Binding RealBackgroundColor, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- 图片背景 -->
                        <StackPanel Grid.Row="1" IsVisible="{Binding IsImageBackground}" Spacing="5">
                            <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_BackgroundImage}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding BackgroundImagePath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Command="{Binding BrowseBackgroundCommand}" Content="{x:Static languages:Languages.Text_ThemeEditor_Browse}"
                                        Margin="5,0,0,0" />
                            </Grid>
                            <Border Margin="0,5" Height="100" VerticalAlignment="Top"
                                    IsVisible="{Binding BackgroundImagePreview, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Border.Background>
                                    <ImageBrush Source="{Binding BackgroundImagePreview}" Stretch="Uniform" />
                                </Border.Background>
                            </Border>
                        </StackPanel>

                        <!-- 通用设置 -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,*">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_FillMode}" VerticalAlignment="Center" />
                                <ComboBox VerticalAlignment="Center" ItemsSource="{Binding FillModes}"
                                          SelectedItem="{Binding BackgroundFillMode}"
                                          Width="150" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_LayerOpacity}" />
                                <Slider Minimum="0" Maximum="1" Value="{Binding LayerOpacity}" Width="200" />
                                <TextBlock Text="{Binding LayerOpacity, StringFormat='{}{0:N2}'}" Margin="5,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Expander>

                <!-- 强调色动画 -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <controls1:IconContent Label="{x:Static languages:Languages.Text_ThemeEditor_AccentAnimation}" Symbol="Highlight" />
                    </Expander.Header>
                    <Grid ColumnDefinitions="2*,3*">
                        <!-- 颜色列表 -->
                        <Border Grid.Column="0" Margin="5">
                            <StackPanel>
                                <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_ColorSequence}" FontWeight="Bold" Margin="0,0,0,5" />
                                <ListBox ItemsSource="{Binding AccentColors}"
                                         SelectedItem="{Binding SelectedAccentColor}" Height="300">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2" Padding="5" CornerRadius="4">
                                                <Border.Styles>
                                                    <Style Selector="Border:pointerover">
                                                        <Setter Property="Background" Value="#30000000" />
                                                    </Style>
                                                </Border.Styles>
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="4"
                                                            Margin="0,0,10,0">
                                                        <Border.Background>
                                                            <SolidColorBrush
                                                                Color="{Binding Color, Converter={x:Static viewModels:StringColorConverter.Instance}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="RGB" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Color}"
                                                               VerticalAlignment="Center" Margin="10,0" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Duration, StringFormat='{}{0:N2}s'}"
                                                               VerticalAlignment="Center" Margin="10,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <controls:CommandBar DefaultLabelPosition="Right">
                                    <controls:CommandBar.PrimaryCommands>
                                        <controls:CommandBarButton Command="{Binding AddColorCommand}" Label="{x:Static languages:Languages.Text_ThemeEditor_AddColor}"
                                                                   IconSource="Add">
                                        </controls:CommandBarButton>
                                        <controls:CommandBarButton Command="{Binding RemoveColorCommand}" Label="{x:Static languages:Languages.Text_ThemeEditor_RemoveColor}"
                                                                   IconSource="Remove"
                                                                   IsEnabled="{Binding CanRemoveColor}">
                                        </controls:CommandBarButton>
                                    </controls:CommandBar.PrimaryCommands>
                                    <controls:CommandBar.SecondaryCommands>

                                        <controls:CommandBarButton Command="{Binding MoveUpCommand}" Label="{x:Static languages:Languages.Text_ThemeEditor_MoveUp}"
                                                                   IconSource="ChevronUp"
                                                                   IsEnabled="{Binding CanMoveUp}">
                                        </controls:CommandBarButton>
                                        <controls:CommandBarButton Command="{Binding MoveDownCommand}" Label="{x:Static languages:Languages.Text_ThemeEditor_MoveDown}"
                                                                   IconSource="ChevronDown"
                                                                   IsEnabled="{Binding CanMoveDown}">
                                        </controls:CommandBarButton>
                                    </controls:CommandBar.SecondaryCommands>
                                </controls:CommandBar>
                            </StackPanel>
                        </Border>

                        <!-- 编辑区域 -->
                        <Border Grid.Column="1" Margin="5">
                            <StackPanel IsVisible="{Binding CanEdit}">
                                <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_EditColor}" FontWeight="Bold" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_ColorValue}" Margin="0,5" />
                                    <TextBox Text="{Binding SelectedAccentColor.Color, Mode=TwoWay}" Width="150" />
                                    <ColorPicker Color="{Binding SelectedAccentColor.RealColor, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_Duration}" Margin="0,10,0,5" />
                                    <Slider Minimum="0.1" Maximum="5" TickFrequency="0.05"
                                            Value="{Binding SelectedAccentColor.Duration, Mode=TwoWay}"
                                            Width="200" />
                                    <TextBlock
                                        Text="{Binding SelectedAccentColor.Duration, StringFormat={x:Static languages:Languages.Text_ThemeEditor_DurationSeconds}}"
                                        Margin="5,0" />
                                </StackPanel>

                                <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_PresetColors}" Margin="0,15,0,5" />
                                <WrapPanel>
                                    <ItemsControl ItemsSource="{Binding PresetColors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="40" Height="40" Margin="2" Theme="{x:Null}"
                                                        Command="{Binding $parent[views:ThemeEditor].DataContext.SetColorCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover">
                                                            <Setter Property="Background">
                                                                <SolidColorBrush
                                                                    Color="{Binding Converter={x:Static viewModels:StringColorConverter.Instance}}" />
                                                            </Setter>
                                                        </Style>
                                                    </Button.Styles>
                                                    <Button.Background>
                                                        <SolidColorBrush
                                                            Color="{Binding Converter={x:Static viewModels:StringColorConverter.Instance}}" />
                                                    </Button.Background>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Static languages:Languages.Text_ThemeEditor_SelectColorHint}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   IsVisible="{Binding !CanEdit}" />

                    </Grid>
                </Expander>

                <!-- 字体设置 -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <controls1:IconContent Label="{x:Static languages:Languages.Text_ThemeEditor_FontSettings}" Symbol="FontSize" />
                    </Expander.Header>
                    <Grid ColumnDefinitions="*,4, *" Margin="10" ColumnSpacing="10">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <RadioButton Content="{x:Static languages:Languages.Text_ThemeEditor_SystemFont}" GroupName="FontTypes"
                                             IsChecked="{Binding IsSystemFont}" />
                                <RadioButton Content="{x:Static languages:Languages.Text_ThemeEditor_CustomFontFile}" GroupName="FontTypes"
                                             IsChecked="{Binding IsCustomFont}" />
                            </StackPanel>

                            <!-- 系统字体选择 -->
                            <StackPanel Grid.Row="1" IsVisible="{Binding IsSystemFont}" Orientation="Horizontal"
                                        Spacing="5">
                                <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_SelectFont}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding AvailableSystemFonts}"
                                          SelectedItem="{Binding SelectedSystemFont}"
                                          Width="250">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{Binding $parent[UserControl].DataContext?.PreviewFontFamily}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- 自定义字体文件 -->
                            <StackPanel Grid.Row="1" IsVisible="{Binding IsCustomFont}" Spacing="5">
                                <TextBlock Text="{x:Static languages:Languages.Text_ThemeEditor_FontFile}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding CustomFontFileName}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Command="{Binding BrowseFontCommand}" Content="{x:Static languages:Languages.Text_ThemeEditor_Browse}"
                                            Margin="5,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- 预览 -->
                            <TextBlock Grid.Row="2" FontFamily="{Binding PreviewFontFamily}"
                                       Text="{Binding FontFamilyPreview}" Margin="0,5"
                                       FontStyle="Italic" Opacity="0.7" />
                        </Grid>
                        <GridSplitter Grid.Column="1" />
                        <Border Grid.Column="2" Margin="5" Padding="10" CornerRadius="8"
                                BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBox x:Name="FontPreviewBox" FontFamily="{Binding PreviewFontFamily}"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     FontSize="14">
                            </TextBox>
                        </Border>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>