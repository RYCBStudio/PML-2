<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:MEFrpLauncherX.Controls"
    xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:views="clr-namespace:MEFrpLauncherX.Views"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="views:UserCenterPage"
    AttachedToVisualTree="UserControl_Loaded"
    x:Class="MEFrpLauncherX.Views.UserCenterPage"
    FontFamily="{StaticResource GlobalFontFamily}"
    mc:Ignorable="d">
    <ScrollViewer x:Name="MainViewer">
        <StackPanel Margin="20" Spacing="16" Classes="animated">

            <!-- 用户基本信息卡片 -->
            <controls1:SettingsExpander
                Header="用户信息"
                IconSource="ContactInfo"
                Description="查看和管理您的账户基本信息"
                IsExpanded="True">

                <controls1:SettingsExpander.Items>
                    <!-- 第一行信息 -->
                    <controls1:SettingsExpanderItem Content="用户名" Classes="r2l">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="UserNameText" Text="加载中..." />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <controls1:SettingsExpanderItem Content="用户ID" Classes="r2l">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="usrId" Text="加载中..." />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <controls1:SettingsExpanderItem Content="注册邮箱" Classes="r2l">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="regMail" Text="加载中..." />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <controls1:SettingsExpanderItem Content="注册时间" Classes="r2l">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="regTime" Text="加载中..." />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <!-- 第二行信息 -->
                    <controls1:SettingsExpanderItem Content="用户组" Classes="r2l">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="group" Text="加载中..." />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <controls1:SettingsExpanderItem Content="账户状态" Classes="r2l">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="status" Text="加载中..." />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <controls1:SettingsExpanderItem Content="实名状态" Classes="r2l">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="isRealNamed" Text="加载中..." />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <controls1:SettingsExpanderItem Content="今日签到" Classes="r2l">
                        <controls1:SettingsExpanderItem.Footer>
                            <Button
                                x:Name="TodaySignButton"
                                Click="Sign"
                                Content="签到"
                                Classes="accent"
                                IsVisible="False" />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>
                </controls1:SettingsExpander.Items>
            </controls1:SettingsExpander>

            <!-- 流量和隧道信息卡片 -->
            <controls1:SettingsExpander
                Header="流量与隧道"
                IconSource="Globe"
                Description="查看您的流量使用情况和隧道配置"
                IsExpanded="True">

                <controls1:SettingsExpander.Items>
                    <controls1:SettingsExpanderItem Content="剩余流量">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="traffic" Text="加载中..." FontSize="16" FontWeight="SemiBold" />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <controls1:SettingsExpanderItem Content="隧道数量">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="proxies" Text="加载中..." FontSize="16" FontWeight="SemiBold" />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <controls1:SettingsExpanderItem Content="入站带宽">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="inBound" Text="加载中..." />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>

                    <controls1:SettingsExpanderItem Content="出站带宽">
                        <controls1:SettingsExpanderItem.Footer>
                            <SelectableTextBlock x:Name="outBound" Text="加载中..." />
                        </controls1:SettingsExpanderItem.Footer>
                    </controls1:SettingsExpanderItem>
                </controls1:SettingsExpander.Items>
            </controls1:SettingsExpander>

            <!-- 流量统计图表 -->
            <controls1:SettingsExpander
                Header="流量统计"
                IconSource="MapDrive"
                Description="查看近期流量使用趋势"
                IsExpanded="True">
                <controls1:SettingsExpanderItem>
                    <Panel MinHeight="300">
                        <controls:TrafficStatusControl x:Name="trafficControl"/>
                    </Panel>
                </controls1:SettingsExpanderItem>
            </controls1:SettingsExpander>

            <!-- 操作区域 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <DockPanel HorizontalSpacing="5">
                        <controls1:SymbolIcon Symbol="Manage" DockPanel.Dock="Left" FontSize="20"/>
                        <TextBlock
                            Text="账户操作"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Click="ExitLogin"
                            Content="退出登录"
                            Classes="danger"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                            <Button.Styles>
                                <Style Selector="Button.accent">
                                    <Setter Property="Background"
                                            Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </Style>
                            </Button.Styles>
                        </Button>

                        <Button
                            Click="OpenWeb">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls1:SymbolIcon Symbol="Globe" />
                                    <TextBlock Text="前往网页端以完成其他操作" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <controls1:InfoBadge
                            Theme="{StaticResource AttentionIconInfoBadgeStyle}"
                            ToolTip.Tip="由于某些原因，网页端的部分功能无法在客户端实现(未开放API)，因此需要您前往网页端进行操作。">
                            <controls1:InfoBadge.IconSource>
                                <controls1:SymbolIconSource Symbol="Help" />
                            </controls1:InfoBadge.IconSource>
                        </controls1:InfoBadge>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>