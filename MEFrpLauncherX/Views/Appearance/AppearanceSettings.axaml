<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:appearance="clr-namespace:MEFrpLauncherX.Views.Appearance"
        Width="500" Height="300"
        x:Class="MEFrpLauncherX.Views.Appearance.AppearanceSettings"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="设置"
        x:DataType="appearance:AppearanceSettingsViewModel">
    <Design.DataContext>
        <appearance:AppearanceSettingsViewModel />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Margin="5" Spacing="5" Classes="animated">
            <controls:SettingsExpander Header="选择一个背景"
                                       IsExpanded="True"
                                       IconSource="Image"
                                       ItemsSource="{Binding Items}" />
            <controls:SettingsExpander Header="背景不透明度" Description="有些时候背景图片可能会影响观感，请选择一个不透明度来调整。">
                <controls:SettingsExpander.Footer>
                    <Slider Maximum="100" Minimum="0" Width="200" x:Name="OpacitySlider" ValueChanged="UpdateOpacity" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>
            <controls:SettingsExpander Header="背景填充模式" Description="设置软件是否应该将背景图片填充整个窗口至标题栏。">
                <controls:SettingsExpander.Footer>
                    <ComboBox x:Name="FillModeBox" SelectionChanged="UpdateBackgroundFillMode">
                        <ComboBoxItem>填充至标题栏</ComboBoxItem>
                        <ComboBoxItem>仅填充至窗口</ComboBoxItem>
                    </ComboBox>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>
            <controls:SettingsExpander Header="选择主题色" IconSource="ColorFill" IsExpanded="True">
                <controls:SettingsExpanderItem>
                    <Grid ColumnDefinitions="*, *" RowDefinitions="*,*,*,*">
                        <Border Grid.ColumnSpan="2" Background="{DynamicResource SystemAccentColor}">
                            <TextBlock Text="SystemAccentColor"
                                       Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SystemAccentColorDark1}">
                            <TextBlock Text="SystemAccentDarkColor1"
                                       Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SystemAccentColorLight1}">
                            <TextBlock Text="SystemAccentLightColor1"
                                       Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource SystemAccentColorDark2}">
                            <TextBlock Text="SystemAccentDarkColor2"
                                       Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SystemAccentColorLight2}">
                            <TextBlock Text="SystemAccentLightColor2"
                                       Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource SystemAccentColorDark3}">
                            <TextBlock Text="SystemAccentDarkColor3"
                                       Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource SystemAccentColorLight3}">
                            <TextBlock Text="SystemAccentLightColor3"
                                       Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Spacing="3">
                            <ColorPicker Color="{DynamicResource SystemAccentColor}"
                                         ColorChanged="ColorView_OnColorChanged" />
                            <Button Click="RestoreDefaultColors">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <controls:SymbolIcon Symbol="Restore" />
                                        <TextBlock Text="还原" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>
            <controls:SettingsExpander Header="自定义主页" Description="您可以选择主页展示的内容。">
                <StackPanel Spacing="3">
                    <CheckBox Content="统计信息" x:Name="ShowStatistics" IsCheckedChanged="UpdateVisibilityForStatistics" />
                    <CheckBox Content="用户信息" x:Name="ShowUserInfo" IsCheckedChanged="UpdateVisibilityForUserInfo" />
                    <CheckBox Content="系统信息" x:Name="ShowSystemInfo" IsCheckedChanged="UpdateVisibilityForSystemInfo" />
                    <CheckBox Content="软件公告" x:Name="ShowSoftwareNotice"
                              IsCheckedChanged="UpdateVisibilityForSoftwareNotice" />
                    <CheckBox Content="系统公告" x:Name="ShowSystemNotice"
                              IsCheckedChanged="UpdateVisibilityForSystemNotice" />
                </StackPanel>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>

    <!-- SettingsExpander supports creating items from DataTemplate -->
    <Window.DataTemplates>
        <DataTemplate DataType="appearance:RecentImagesSettingsItem">
            <controls:SettingsExpanderItem>
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Header}" />
                    <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Name="PART_ContentPresenter"
                                                          Background="{TemplateBinding Background}"
                                                          BorderBrush="{DynamicResource AccentButtonBackground}"
                                                          BorderThickness="2"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Content="{TemplateBinding Content}"
                                                          Padding="{TemplateBinding Padding}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          CornerRadius="{TemplateBinding CornerRadius}" />
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding }" Height="70" Width="90" Stretch="UniformToFill" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </controls:SettingsExpanderItem>
        </DataTemplate>

        <DataTemplate DataType="appearance:FooterButtonSettingsItem">
            <controls:SettingsExpanderItem>
                <controls:SettingsExpanderItem.Footer>
                    <WrapPanel ItemSpacing="5">
                        <Button Content="{Binding Footer}" Command="{Binding SelectBackgroundCommand}" />
                        <Button Content="清除所有背景" Command="{Binding ClearFileCommand}" />
                    </WrapPanel>
                </controls:SettingsExpanderItem.Footer>
            </controls:SettingsExpanderItem>
        </DataTemplate>
    </Window.DataTemplates>
</Window>