<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="320"
             x:Class="MEFrpLauncherX.Console.TerminalControl">
    <Grid RowDefinitions="Auto,*,Auto" ZIndex="1" Classes="animated">
        <Grid ColumnDefinitions="*,*" Margin="3" ColumnSpacing="10">
            <Border Margin="6,0,0,0" CornerRadius="8"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                <DockPanel Margin="3" HorizontalSpacing="4" VerticalSpacing="4"
                           IsVisible="{Binding Path=#ErrorText.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <controls:SymbolIcon x:Name="ErrorIcon" DockPanel.Dock="Left" Symbol="Alert"
                                         Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="ErrorText"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </DockPanel>
            </Border>
            <Border Margin="0,0,6,0" Grid.Column="1" CornerRadius="8"
                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                <DockPanel Margin="3" HorizontalSpacing="4" VerticalSpacing="4"
                           IsVisible="{Binding Path=#ErrorText.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <controls:SymbolIcon x:Name="SolutionIcon" DockPanel.Dock="Left" Symbol="Checkmark"
                                         Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <HyperlinkButton DockPanel.Dock="Right" Click="ViewErrorDetails">
                        <TextBlock>查看详情</TextBlock>
                    </HyperlinkButton>
                    <TextBlock x:Name="SolutionBox"
                               IsVisible="{Binding Path=#SolutionBox.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </DockPanel>
            </Border>
        </Grid>
        <avaloniaEdit:TextEditor Grid.Row="1" x:Name="OutputBox"
                                 FontFamily="{StaticResource Jbm}"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 WordWrap="True" />
        <TextBox x:Name="InputBox"
                 Grid.Row="2"
                 Margin="0,5,0,0"
                 Watermark="Enter command..."
                 FontFamily="{StaticResource Jbm}"
                 FontSize="14" />
    </Grid>
</UserControl>