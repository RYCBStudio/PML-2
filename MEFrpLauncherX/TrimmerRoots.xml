<?xml version="1.0" encoding="utf-8"?>
<linker>
    <!-- 主程序集与业务程序集：XAML 反射绑定需要，保守全量保留 -->
    <assembly fullname="MEFrpLauncherX">
        <type fullname="*" preserve="all"/>
    </assembly>
    <assembly fullname="MEFrpLauncherX.Core">
        <type fullname="*" preserve="all"/>
    </assembly>
    <assembly fullname="MEFrpLauncherX.Plugin">
        <type fullname="*" preserve="all"/>
    </assembly>
    <assembly fullname="MEFrpLauncherX.Fonts">
        <type fullname="*" preserve="all"/>
    </assembly>

    <!-- Avalonia 核心：Media.* 已覆盖 Imaging / ImageBrush 等子命名空间 -->
    <assembly fullname="Avalonia.Base">
        <type fullname="Avalonia.Media.*" preserve="all"/>
        <type fullname="Avalonia.Platform.IAssetLoader" preserve="all"/>
        <type fullname="Avalonia.Platform.AssetLoader" preserve="all"/>
    </assembly>

    <!-- Avalonia.Markup.* 已覆盖 Parsers / Data 等子命名空间 -->
    <assembly fullname="Avalonia.Markup">
        <type fullname="Avalonia.Markup.*" preserve="all"/>
    </assembly>

    <!-- XAML 加载器本体 -->
    <assembly fullname="Avalonia.Markup.Xaml">
        <type fullname="*" preserve="all"/>
    </assembly>

    <!-- 标准控件：若 csproj 已用 TrimmerRootAssembly 保留，可删掉此块 -->
    <assembly fullname="Avalonia.Controls">
        <type fullname="*" preserve="all"/>
    </assembly>

    <!-- ReactiveUI：按实际用到的 API 保留 -->
    <assembly fullname="ReactiveUI">
        <type fullname="ReactiveUI.ReactiveCommand" preserve="all"/>
        <type fullname="ReactiveUI.ReactiveCommand`2" preserve="all"/>
        <type fullname="ReactiveUI.ReactiveObject" preserve="all"/>
        <type fullname="ReactiveUI.ObservableAsPropertyHelper`1" preserve="all"/>
    </assembly>

    <!-- 端子控件（Avalonia 12 实际程序集名） -->
    <assembly fullname="Iciclecreek.Avalonia.Terminal">
        <type fullname="*" preserve="all"/>
    </assembly>
    <assembly fullname="Iciclecreek.Avalonia.WindowManager">
        <type fullname="*" preserve="all"/>
    </assembly>
    <assembly fullname="Porta.Pty">
        <type fullname="*" preserve="all"/>
    </assembly>

    <!-- TypeDescriptor / TypeConverter：XAML 类型转换依赖 -->
    <assembly fullname="System.ComponentModel.TypeConverter">
        <type fullname="System.ComponentModel.TypeDescriptor" preserve="all"/>
        <type fullname="System.ComponentModel.TypeConverter" preserve="all"/>
    </assembly>

    <!-- DataAnnotations：仅保留 MaxLengthAttribute，如用 Validator 需扩展 -->
    <assembly fullname="System.ComponentModel.Annotations">
        <type fullname="System.ComponentModel.DataAnnotations.MaxLengthAttribute" preserve="all"/>
    </assembly>

    <!-- 已删除：System.Runtime.Serialization.Formatters（.NET 8+ AOT 不支持） -->
    <!-- 已删除：重复的 Avalonia.Markup.Xaml 块 -->
    <!-- 已删除：Avalonia.Media.* 下的冗余显式类型 -->
</linker>