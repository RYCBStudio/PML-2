<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls1="clr-namespace:MEFrpLauncherX.Controls">
    <Design.PreviewWith>
        <Border Padding="20">
            <controls1:AnimatedFAProgressRing />
        </Border>
    </Design.PreviewWith>
    
    <Style Selector="GridSplitter">
        <Setter Property="CornerRadius" Value="50" />
    </Style>

    <Style Selector="controls1|AnimatedFAProgressRing">
        <Style.Animations>
            <Animation Duration="0:0:2.5" IterationCount="INFINITE" Easing="QuarticEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0.0" />
                </KeyFrame>
                <KeyFrame Cue="98%">
                    <Setter Property="RotateTransform.Angle" Value="360.0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ========== Fluent Card 样式（用于 HeaderedContentControl） ========== -->
    <Style Selector="HeaderedContentControl.FluentCard">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- 阴影改用 Border.BoxShadow 而不是 DropShadowEffect：
                     DropShadowEffect 属于像素效果，会把 Border 及其子树光栅化到中间 surface 再应用
                     ImageFilter，每张卡都因此多出一个合成层；首页/收件箱同时存在 11 张 FluentCard，
                     叠加「强调色呼吸动画每帧触发全树 DynamicResource 失效」后，这些层会被反复重绘。
                     BoxShadow 由 Border 在绘制背景时直接画阴影，不产生中间 surface，视觉几乎一致。 -->
                <Border CornerRadius="8"
                        Margin="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BoxShadow="0 2 6 0 #14000000">
                    <Grid RowDefinitions="Auto,*">
                        <!-- 标题栏 -->
                        <Border CornerRadius="8,8,0,0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                Padding="12,8">
                            <TextBlock Text="{TemplateBinding Header}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <!-- 内容区域 -->
                        <Border Grid.Row="1"
                                Background="Transparent"
                                Padding="12">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- 悬浮放大效果 -->
        <Setter Property="RenderTransform">
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>

    <Style Selector="HeaderedContentControl.FluentCard:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.02)" />
        <!-- 原先这里再设一次 DropShadowEffect，等于给控件额外加一层合成层；
             模板内的 Border 阴影始终存在，hover 的视觉反馈由放大 + 该阴影共同提供。
             若需要 hover 时阴影更重，请改用模板内 Border 的 BoxShadow 差值，而不要叠加 Effect。 -->
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="SineEaseInOut">
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.02" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.02" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ========== GridSplitter 样式 ========== -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Width" Value="4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>

    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Style.Animations>
            <Animation Duration="0:0:0.1" Easing="SineEaseIn">
                <!-- <KeyFrame Cue="0%"> -->
                <!--     <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" /> -->
                <!-- </KeyFrame> -->
                <KeyFrame Cue="100%">
                    <Setter Property="Width" Value="6" />
                    <Setter Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ========== AnimatedFAProgressRing 动画优化 ========== -->
    <!-- <Style Selector="controls1|AnimatedFAProgressRing"> -->
    <!--     <Style.Animations> -->
    <!--         <Animation Duration="0:0:1.5" IterationCount="INFINITE" Easing="LinearEasing"> -->
    <!--             <KeyFrame Cue="0%"> -->
    <!--                 <Setter Property="RotateTransform.Angle" Value="0" /> -->
    <!--             </KeyFrame> -->
    <!--             <KeyFrame Cue="100%"> -->
    <!--                 <Setter Property="RotateTransform.Angle" Value="360" /> -->
    <!--             </KeyFrame> -->
    <!--         </Animation> -->
    <!--     </Style.Animations> -->
    <!-- </Style> -->
</Styles>