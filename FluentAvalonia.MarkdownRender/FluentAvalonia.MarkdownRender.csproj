<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <PackageId>FluentAvalonia.MarkdownRender</PackageId>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>FluentAvalonia Markdown 渲染组件</Title>
        <Description>Avalonia / FluentAvalonia 风格的 Markdown 渲染组件，支持标题、列表、引用、代码高亮、图片、内联 HTML、GitHub 风格警告框（Alert）以及 GFM 表格。</Description>
        <PackageProjectUrl>https://github.com/RYCBStudio/PML-2</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/RYCBStudio/PML-2</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Avalonia;FluentAvalonia;Markdown;MarkdownRender;Table</PackageTags>
        <PackageReleaseNotes>重命名自 Markdown.AIRender（https://github.com/AIDotNet/Markdown.AIRender），并新增 GFM 表格渲染支持。</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <Copyright>MIT</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.20" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="11.4.1" />
        <PackageReference Include="Avalonia.Skia" Version="11.3.20" />
        <PackageReference Include="Avalonia.Svg" Version="11.3.0" />
        <PackageReference Include="FluentAvaloniaUI" Version="2.5.1"/>
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.5" />
        <PackageReference Include="Markdig" Version="1.4.0" />
        <PackageReference Include="SkiaSharp" Version="4.151.2" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
        <PackageReference Include="TextMateSharp" Version="2.0.4" />
        <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    </ItemGroup>
    
</Project>
