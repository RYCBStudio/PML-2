<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <PackageId>FluentAvalonia.MarkdownRender</PackageId>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>FluentAvalonia Markdown 渲染组件</Title>
        <Description>Avalonia / FluentAvalonia 风格的 Markdown 渲染组件，支持标题、列表、引用、代码高亮、图片、内联 HTML、GitHub 风格警告框（Alert）以及 GFM 表格。</Description>
        <PackageProjectUrl>https://github.com/RYCBStudio/PML-2</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/RYCBStudio/PML-2</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Avalonia;FluentAvalonia;Markdown;MarkdownRender;Table</PackageTags>
        <PackageReleaseNotes>重命名自 Markdown.AIRender（https://github.com/AIDotNet/Markdown.AIRender），并新增 GFM 表格渲染支持。</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <Copyright>MIT</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <!-- 版本统一由仓库根目录 Directory.Packages.props 中央管理 -->
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.AvaloniaEdit" />
        <PackageReference Include="AvaloniaEdit.TextMate" />
        <PackageReference Include="Avalonia.Skia" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
        <PackageReference Include="FluentAvaloniaUI"/>
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
        <PackageReference Include="Markdig" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
        <PackageReference Include="TextMateSharp" />
        <PackageReference Include="TextMateSharp.Grammars" />
    </ItemGroup>
    
</Project>
