    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MarkdownAIRender/Themes/Controls/_index.axaml" />
                <ResourceInclude Source="avares://MarkdownAIRender/Themes/Shared/_index.axaml" />
